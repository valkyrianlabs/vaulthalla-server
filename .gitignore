# ═══════════════════════════════════════════════════════
# 🧠 VAULTHALLA GLOBAL
# ═══════════════════════════════════════════════════════

# Dev
/**/.idea
~/*
/.env
/.venv
/.codex/scratch/
/.claude/scratch/
/.claude/settings.local.json
/config.yaml
enable_dev_mode
*__pycache__*
cloudflare.ini

# Deployment Artifacts
/deploy/vaulthalla.env
/deploy/hash_password
/deploy/bashrc
# TEST-ONLY provider credentials (only the .example is tracked)
providers.env
/tools/lab/*.env
/.bashrc

# Core build (also cover root-level build artifacts)
/build/
/build-asan/
/build-check/
/build-check-install/
/build-install/
/build-macos/
/core/build/

# Production artifacts (multi-project)
*/dist/
*/.release_notes

# macOS / misc
.DS_Store
*.pem
# Public verification keys of test fixtures (no private keys are ever committed).
!core/test-assets/**/public-key.pem

# Debug logs (global)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ═══════════════════════════════════════════════════════
# 📦 DEBIAN PACKAGING
# ═══════════════════════════════════════════════════════

/debian/**/*debhelper*
/debian/vaulthalla-server
/debian/vaulthalla.substvars
/debian/files
/debian/tmp
/debian/vaulthalla
/release/
/dist/
/obj-x86_64-linux-gnu/

# ═══════════════════════════════════════════════════════
# 🌐 WEB (scoped to /web)
# ═══════════════════════════════════════════════════════

# dependencies
/web/node_modules/
/web/.pnp
/web/.pnp.*
/web/.yarn/*
!/web/.yarn/patches
!/web/.yarn/plugins
!/web/.yarn/releases
!/web/.yarn/versions

# build output
/web/.next/
/web/out/
/web/build/

# testing
/web/coverage/
/web/playwright-report/
/web/test-results/
/test-results/

# env files (web-specific)
/web/.env*

# typescript
/web/*.tsbuildinfo
/web/next-env.d.ts

# vercel
/web/.vercel

# misc web
/web/public/icons/fa/
