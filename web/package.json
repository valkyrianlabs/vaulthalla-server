{
  "name": "vaulthalla-web",
  "version": "1.19.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:e2e": "NEXT_PUBLIC_VAULTHALLA_WS_ORIGIN=${NEXT_PUBLIC_VAULTHALLA_WS_ORIGIN:-ws://127.0.0.1:36969} VAULTHALLA_AUTH_ORIGIN=${VAULTHALLA_AUTH_ORIGIN:-http://127.0.0.1:36970} VAULTHALLA_PREVIEW_ORIGIN=${VAULTHALLA_PREVIEW_ORIGIN:-http://127.0.0.1:36970} next dev --turbopack --hostname ${VAULTHALLA_E2E_WEB_HOST:-127.0.0.1} --port ${VAULTHALLA_E2E_WEB_PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "pnpm run typecheck && pnpm run lint && pnpm run colors",
    "test:e2e": "playwright test",
    "test:e2e:s3-gateway": "playwright test tests/e2e/s3-gateway.spec.ts",
    "playwright:install": "playwright install",
    "budgets": "node bin/check-budgets.mjs",
    "colors": "node bin/check-colors.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.29.0",
    "@babylonjs/loaders": "9.29.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "draco3dgltf": "1.5.7",
    "meshoptimizer": "1.3.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.73.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.0.8"
}
