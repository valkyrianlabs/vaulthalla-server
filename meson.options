option(
    'systemd_system_unit_dir',
    type: 'string',
    value: '/lib/systemd/system',
    description: 'Directory for systemd service files'
)

option(
    'udev_rules_dir',
    type: 'string',
    value: '/usr/lib/udev/rules.d',
    description: 'Directory for udev rules'
)

option(
    'tmpfiles_dir',
    type: 'string',
    value: '/usr/lib/tmpfiles.d',
    description: 'Directory for systemd-tmpfiles declarations'
)

option('manpage', type: 'boolean', value: true, description: 'Build and install manpage via pandoc')

option(
    'install_data',
    type: 'boolean',
    value: true,
    description: 'Install data files (e.g. systemd unit files, manpage, etc.)'
)

option(
    'build_unit_tests',
    type: 'boolean',
    value: false,
    description: 'Build all unit test executables'
)

option(
    'integration_tests',
    type: 'boolean',
    value: false,
    description: 'Build integration test executable'
)

option(
    'install_local_config_override',
    type: 'boolean',
    value: false,
    description: 'Source installs only: also install the gitignored repo-root config.yaml into sysconfdir/vaulthalla (never enabled for package builds)'
)

option(
    'preview_cad',
    type: 'feature',
    value: 'auto',
    description: 'Build the optional vaulthalla-preview-cad converter helper (STEP/STP -> GLB; needs OCCT and libseccomp)'
)

option(
    'preview_media',
    type: 'feature',
    value: 'auto',
    description: 'Build the optional vaulthalla-preview-media converter helper (posters/transcodes; needs libav* and libseccomp)'
)

option(
    'fuse',
    type: 'feature',
    value: 'auto',
    description: 'Build the kernel FUSE bridge (libfuse3). auto: required on Linux, off elsewhere (macOS serves vaults over HTTP/WS/CLI until a Finder backend is chosen)'
)

option(
    'http_upload_staging',
    type: 'combo',
    choices: ['auto', 'mount', 'private'],
    value: 'auto',
    description: 'Where HTTP uploads stage before commit (protocols/http/upload/Staging.hpp). auto: mount on Linux (through the FUSE mount, as always), private elsewhere (daemon-private, mount-independent)'
)

option(
    'instance',
    type: 'string',
    value: '',
    description: 'Empty (default): the production install. A name (e.g. dev, used by `make dev`): an isolated instance whose every compiled-in location, service account, service name and CLI socket carries the name, so it never touches a production install on the same host'
)
