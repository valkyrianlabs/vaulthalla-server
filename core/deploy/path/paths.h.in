#pragma once

#define VH_CONFIG_PATH @VH_CONFIG_PATH@
#define VH_LOG_PATH @VH_LOG_PATH@
#define VH_MOUNT_PATH @VH_MOUNT_PATH@
#define VH_BACKING_PATH @VH_BACKING_PATH@
#define VH_RUNTIME_PATH @VH_RUNTIME_PATH@
#define VH_LIFECYCLE_PATH @VH_LIFECYCLE_PATH@
// The instance ("" = production; e.g. "dev" for `make dev`), its service account (user and group; on macOS the record
// alias of the hidden role account) and its systemd unit. An instance never shares any of them with production.
#define VH_INSTANCE @VH_INSTANCE@
#define VH_SERVICE_ACCOUNT @VH_SERVICE_ACCOUNT@
#define VH_SYSTEMD_UNIT @VH_SYSTEMD_UNIT@
// The daemon's CLI socket and the first-install DB password handoff, both in the runtime directory.
#define VH_CLI_SOCKET_PATH VH_RUNTIME_PATH "/cli.sock"
#define VH_DB_PASSWORD_SEED_PATH VH_RUNTIME_PATH "/db_password"
// How `vh` tells the operator to inspect the service, read its log, and enroll a user for the CLI socket.
#define VH_HINT_SERVICE_NAME @VH_HINT_SERVICE_NAME@
#define VH_HINT_SERVICE_STATUS @VH_HINT_SERVICE_STATUS@
#define VH_HINT_SERVICE_LOG @VH_HINT_SERVICE_LOG@
#define VH_HINT_CLI_ENROLL @VH_HINT_CLI_ENROLL@
#define VH_CACHE_PATH @VH_CACHE_PATH@
#define VH_S3_GATEWAY_MULTIPART_PARTS_DIRNAME @VH_S3_GATEWAY_MULTIPART_PARTS_DIRNAME@
#define VH_PSQL_SCHEMAS_PATH @VH_PSQL_SCHEMAS_PATH@
#define VH_MAGIC_DB_PATH @VH_MAGIC_DB_PATH@
#define VH_PSQL_TEST_SCHEMAS_PATH @VH_PSQL_TEST_SCHEMAS_PATH@

#include <cstdlib>
#include <filesystem>

namespace vh::paths {

inline bool testMode = false;
inline std::filesystem::path configPath = VH_CONFIG_PATH;
inline std::filesystem::path logPath = VH_LOG_PATH;
inline std::filesystem::path backingPath = VH_BACKING_PATH;
inline std::filesystem::path mountPath = VH_MOUNT_PATH;
inline std::filesystem::path runtimePath = VH_RUNTIME_PATH;
inline std::filesystem::path psqlSchemaPath = VH_PSQL_SCHEMAS_PATH;
inline std::filesystem::path psqlTestSchemaPath = VH_PSQL_TEST_SCHEMAS_PATH;
inline std::filesystem::path cliSocketPath = VH_CLI_SOCKET_PATH;
// Set only by enableTestMode() from VH_TEST_CLI_SOCKET: a private test instance serves `vh` on its own socket.
inline bool testCliSocket = false;

inline void setLogPathForTesting() {
    const char* forced = std::getenv("VH_TEST_LOG_PATH");
    logPath = forced && *forced ? std::filesystem::path(forced) : std::filesystem::temp_directory_path() / "vh_log";
    if (!std::filesystem::exists(logPath)) {
        std::filesystem::create_directories(logPath);
        std::filesystem::permissions(
            logPath,
            std::filesystem::perms::owner_all | std::filesystem::perms::group_read | std::filesystem::perms::others_read,
            std::filesystem::perm_options::replace
        );
    }
}

inline void enableTestMode() {
    testMode = true;
    constexpr const char* backingEnv = "VH_TEST_BACKING_PATH";
    constexpr const char* mountEnv = "VH_TEST_MOUNT_PATH";

    backingPath = std::getenv(backingEnv)
        ? std::filesystem::path(std::getenv(backingEnv))
        : std::filesystem::temp_directory_path() / "vh_backing";
    mountPath = std::getenv(mountEnv)
        ? std::filesystem::path(std::getenv(mountEnv))
        : std::filesystem::temp_directory_path() / "vh_mount";

    setLogPathForTesting();

    constexpr const char* envVar = "VH_PATH_TO_SUPERADMIN_UID";
    if (std::getenv(envVar)) runtimePath = std::getenv(envVar);
    else runtimePath = std::filesystem::temp_directory_path() / "vh_runtime";  // this may cause errors if not set

    constexpr const char* envVar2 = "VH_PATH_TO_CONFIG";
    if (std::getenv(envVar2)) configPath = std::getenv(envVar2);

    if (const char* socket = std::getenv("VH_TEST_CLI_SOCKET"); socket && *socket) {
        cliSocketPath = socket;
        testCliSocket = true;
    }
}

inline bool isTestMode() { return testMode; }

inline std::filesystem::path getConfigPath() { return configPath; }
inline std::filesystem::path getLogPath() { return logPath; }
inline std::filesystem::path getMountPath() { return mountPath; }
inline std::filesystem::path getBackingPath() { return backingPath; }
inline std::filesystem::path getRuntimePath() { return runtimePath; }
inline std::filesystem::path getCachePath() { return VH_CACHE_PATH; }
inline std::filesystem::path getS3GatewayMultipartPartsPath() { return getBackingPath() / VH_S3_GATEWAY_MULTIPART_PARTS_DIRNAME; }
inline std::filesystem::path getPsqlSchemasPath() { return isTestMode() ? VH_PSQL_TEST_SCHEMAS_PATH : VH_PSQL_SCHEMAS_PATH; }
inline std::filesystem::path getCliSocketPath() { return cliSocketPath; }
}
