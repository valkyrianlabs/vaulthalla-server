[wrap-file]
directory = vl-vaultfmt-0.4.0
# No release exists yet: the tarball is `git archive` of vl-vaultfmt's commit 0e81c8d043c8f6d841805abb1926b4cdfb6727d3
# (version 0.4.0, untagged: branch fix/start-ordered-versions, one writer safe under Backblaze's start-ordered versions,
# several writers refused on version_log, the wasm reader re-recorded), made reproducibly (the same bytes with xz 5.4
# and 5.8) with
#   git -C vl-vaultfmt archive --format=tar --prefix=vl-vaultfmt-0.4.0/ 0e81c8d043c8f6d841805abb1926b4cdfb6727d3 \
#     | xz -9 -T1 > vl-vaultfmt-0.4.0.tar.xz
# and committed under subprojects/packagecache/, so every build (and the Debian build, --wrap-mode=nodownload) uses it
# without the network. source_url names the release asset 0.4.0 will publish; the wrap is bumped to that tarball then.
source_url = https://github.com/valkyrianlabs/vl-vaultfmt/releases/download/v0.4.0/vl-vaultfmt-0.4.0.tar.xz
source_filename = vl-vaultfmt-0.4.0.tar.xz
source_hash = b78d34a28ea218c9c349d6f823ddbc8253ab6e7ebf030da313cace44c6323395

[provide]
vl-vaultfmt = vl_vaultfmt_dep
