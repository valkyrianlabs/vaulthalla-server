[wrap-file]
directory = vl-vaultfmt-0.3.0
# No release exists yet: the tarball is `git archive` of vl-vaultfmt's commit 54742cbd2aecc839d2faa36ba3b2e5f129949ad9
# (version 0.3.0, untagged: main after pull request 4, whose sources are those of 0.3.0's ad6490b; it changed only CI),
# made reproducibly (the same bytes with xz 5.4 and 5.8) with
#   git -C vl-vaultfmt archive --format=tar --prefix=vl-vaultfmt-0.3.0/ 54742cbd2aecc839d2faa36ba3b2e5f129949ad9 \
#     | xz -9 -T1 > vl-vaultfmt-0.3.0.tar.xz
# and committed under subprojects/packagecache/, so every build (and the Debian build, --wrap-mode=nodownload) uses it
# without the network. source_url names the release asset 0.3.0 will publish; the wrap is bumped to that tarball then.
source_url = https://github.com/valkyrianlabs/vl-vaultfmt/releases/download/v0.3.0/vl-vaultfmt-0.3.0.tar.xz
source_filename = vl-vaultfmt-0.3.0.tar.xz
source_hash = a99becaa0ea7ce0551e62ed53e9bd8a1f72ecba3e8914a4813b10b946ee2ad47

[provide]
vl-vaultfmt = vl_vaultfmt_dep
