[wrap-file]
directory = vl-vaultfmt-0.1.0
# No release exists yet: the tarball is `git archive` of vl-vaultfmt's commit d9773a85558c33afbcb3aa0ba17f851855cfbdb7
# (version 0.1.0, untagged), made reproducibly (the same bytes with xz 5.4 and 5.8) with
#   git -C vl-vaultfmt archive --format=tar --prefix=vl-vaultfmt-0.1.0/ d9773a85558c33afbcb3aa0ba17f851855cfbdb7 \
#     | xz -9 -T1 > vl-vaultfmt-0.1.0.tar.xz
# and committed under subprojects/packagecache/, so every build (and the Debian build, --wrap-mode=nodownload) uses it
# without the network. source_url names the release asset 0.1.0 will publish; the wrap is bumped to that tarball then.
source_url = https://github.com/valkyrianlabs/vl-vaultfmt/releases/download/v0.1.0/vl-vaultfmt-0.1.0.tar.xz
source_filename = vl-vaultfmt-0.1.0.tar.xz
source_hash = 361bba78c5d505b1371ddf168d020585198d1b2f48fe30564730fd6734d87626

[provide]
vl-vaultfmt = vl_vaultfmt_dep
