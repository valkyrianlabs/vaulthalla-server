[wrap-file]
directory = vl-keykit-0.2.0
source_url = https://github.com/valkyrianlabs/vl-keykit/releases/download/v0.2.0/vl-keykit-0.2.0.tar.xz
source_filename = vl-keykit-0.2.0.tar.xz
source_hash = 676a981493871e9541c50ed1165ec00709c22fe60686e94229339866364a44a0
# 0.2.0's account_key.cpp and recovery_policy.cpp both define a file-local kVersionStem, so the library doesn't build as
# one unity translation unit (this project's unity=on reaches subprojects). The patch renames the policy's; remove it
# with the release that fixes it.
diff_files = vl-keykit-0.2.0-unity.patch

[provide]
vl-keykit = vl_keykit_dep
