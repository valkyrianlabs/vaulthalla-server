# Vaulthalla TEST-ONLY provider credentials (live provider tests)
#
# Canonical host path: /etc/vaulthalla/testing/providers.env
#   owner root:vaulthalla, mode 0640, directory /etc/vaulthalla/testing 0750.
#   Install/refresh the scaffold with:  bash tools/lab/test_providers.sh install [--host <ssh-alias>]
#   Check what is filled in (names only, never values):  bash tools/lab/test_providers.sh check [--host <ssh-alias>]
#
# Rules:
#   * A TEST account's R2 admin key. Never production credentials. Live tests are opt-in (VH_LIVE_TESTS=1).
#   * Every bucket a test creates is named vh-test-<host>-<pid>-<start> and is deleted after the run, also when
#     tests fail; the test helper refuses every other bucket (core/tests/helpers/live_bucket.hpp).
#   * This file is operator-managed. The vaulthalla package never ships, reads, rewrites or
#     deletes it (upgrades and purge leave it alone); remove it explicitly when done.
#   * The daemon does NOT load it. Test harnesses source it (tools/e2e/load_env.sh does when readable).
#   * Never commit a filled copy; *.env files outside *.example are gitignored.
#
# Variable names match what the live tests read.

# --- Cloudflare R2 (admin key of a test account) -------------------------------
VH_R2_ADMIN_ACCESS_KEY="CHANGE_ME"                    # R2 API token access key id (Admin Read & Write)
VH_R2_ADMIN_SECRET_KEY="CHANGE_ME"
VH_R2_ADMIN_ENDPOINT="CHANGE_ME"                      # https://<account-id>.r2.cloudflarestorage.com
VH_R2_ADMIN_REGION="auto"                             # R2 uses "auto"

# --- Cloudflare API token (optional: the R2 event-notification test) ----------
VH_CF_API_TOKEN="CHANGE_ME"                           # Queues: Edit, Workers R2 Storage: Edit
