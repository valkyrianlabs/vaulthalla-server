# Vaulthalla TEST-ONLY provider credentials (Phase 2 runtime/provider testing)
#
# Canonical host path: /etc/vaulthalla/testing/providers.env
#   owner root:vaulthalla, mode 0640, directory /etc/vaulthalla/testing 0750.
#   Install/refresh the scaffold with:  bash tools/lab/test_providers.sh install [--host <ssh-alias>]
#   Check what is filled in (names only, never values):  bash tools/lab/test_providers.sh check [--host <ssh-alias>]
#
# Rules:
#   * Use DEDICATED test buckets and least-privilege keys scoped to those buckets only.
#     Never put production credentials here. Tests may create, overwrite and delete objects,
#     only under vh-test-runs/ (core/tests/helpers/live_bucket.hpp). No test creates, deletes or
#     reconfigures a bucket: provision these by hand, once.
#   * This file is operator-managed. The vaulthalla package never ships, reads, rewrites or
#     deletes it (upgrades and purge leave it alone); remove it explicitly when done.
#   * The daemon does NOT load it. Test harnesses source it (tools/e2e/load_env.sh does when readable).
#   * Never commit a filled copy; *.env files outside *.example are gitignored.
#
# Variable names match what core tests and tools/smoke already read.

# --- AWS S3 (one dedicated test bucket; unversioned or versioning Enabled) ------
VAULTHALLA_TEST_S3_BUCKET="CHANGE_ME"                 # e.g. vaulthalla-phase2-test
VAULTHALLA_TEST_S3_REGION="CHANGE_ME"                 # e.g. us-east-1
VAULTHALLA_TEST_S3_ENDPOINT="CHANGE_ME"               # e.g. https://s3.us-east-1.amazonaws.com
VAULTHALLA_TEST_S3_ACCESS_KEY="CHANGE_ME"             # IAM access key id scoped to the bucket
VAULTHALLA_TEST_S3_SECRET_ACCESS_KEY="CHANGE_ME"

# --- Cloudflare R2 (one dedicated test bucket) --------------------------------
VAULTHALLA_TEST_R2_BUCKET="CHANGE_ME"                 # e.g. vaulthalla-phase2-test
VAULTHALLA_TEST_R2_REGION="auto"                      # R2 uses "auto"
VAULTHALLA_TEST_R2_ENDPOINT="CHANGE_ME"               # https://<account-id>.r2.cloudflarestorage.com
VAULTHALLA_TEST_R2_ACCESS_KEY="CHANGE_ME"             # R2 API token access key id (bucket-scoped)
VAULTHALLA_TEST_R2_SECRET_ACCESS_KEY="CHANGE_ME"

# --- Safety rails for Phase 2 harnesses ---------------------------------------
# Object key prefix every test must write under (cleanup deletes only this prefix). The C++ live
# tests and tools/smoke always use vh-test-runs/<host>-<pid>-<start>/...
VAULTHALLA_TEST_PROVIDER_PREFIX="vh-test-runs/"
# Set to 1 only when destructive/stress provider tests are explicitly intended.
VAULTHALLA_TEST_PROVIDER_DESTRUCTIVE="0"
