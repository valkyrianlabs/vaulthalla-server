    <!-- Off unless chosen (Installer: Customize; Homebrew: the vaulthalla cask's `choices:`), so `sudo installer -pkg`
         stays headless. Vaulthalla Desktop needs macOS 27. The component is version-checked: a newer app that Sparkle
         already installed is never replaced by the bundled one. -->
    <choice id="sh.vaulthalla.desktop" title="Vaulthalla Desktop @DESKTOP_VERSION@" start_selected="false"
        visible="desktop_supported()" enabled="desktop_supported()"
        description="The Vaulthalla app for this Mac, in /Applications. It updates itself; skipped if a newer copy is installed.">
        <pkg-ref id="sh.vaulthalla.desktop"/>
    </choice>
    <pkg-ref id="sh.vaulthalla.desktop" version="@DESKTOP_VERSION@" onConclusion="none">desktop.pkg</pkg-ref>
    <script>
        function desktop_supported() { return system.compareVersions(system.version.ProductVersion, '27.0') >= 0; }
    </script>
