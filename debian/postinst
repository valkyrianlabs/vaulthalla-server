#!/bin/sh
set -e

# postinst for vaulthalla
# - Creates system user/group + runtime dirs
# - Installs the default config into /etc only when it is missing (never overwrites)
# - Performs conservative optional local PostgreSQL bootstrap when available
# - Performs conservative optional nginx integration when available
# - Prompts only when an existing Vaulthalla database has no sealed credential on
#   this host (adopt / overwrite / abort); noninteractive installs use
#   VH_EXISTING_DB_ACTION and default to abort
# - Does NOT perform package-time super-admin UID binding
# - Never blocks indefinitely: every systemctl/psql/nginx/udev call is bounded and
#   the FUSE mount root is only ever inspected through /proc/self/mountinfo
#
# Advanced opt-outs (persisted under /var/lib/vaulthalla once used):
#   VH_SKIP_DB_BOOTSTRAP=1
#   VH_SKIP_NGINX_CONFIG=1
# Existing-database resolution:
#   VH_EXISTING_DB_ACTION=adopt|overwrite|abort

PKG="vaulthalla"
DB_USER="vaulthalla"
DB_NAME="vaulthalla"
STATE_DIR="/var/lib/vaulthalla"
LOG_DIR="/var/log/vaulthalla"
RUNTIME_DIR="/run/vaulthalla"
CONFIG_DIR="/etc/vaulthalla"
CONFIG_FILE="${CONFIG_DIR}/config.yaml"
CONFIG_TEMPLATE_FILE="${CONFIG_DIR}/config_template.yaml.in"
PACKAGED_CONFIG_DIR="/usr/share/vaulthalla/config"
LEGACY_PENDING_SUPERADMIN_UID_FILE="${RUNTIME_DIR}/superadmin_uid"
PENDING_DB_PASS_FILE="${RUNTIME_DIR}/db_password"
SEALED_DB_SECRET_DIR="${STATE_DIR}/.sealed_psql.blob"
DB_BOOTSTRAP_OPTOUT_MARKER="${STATE_DIR}/db_bootstrap_disabled"
NGINX_OPTOUT_MARKER="${STATE_DIR}/nginx_config_disabled"
INITIAL_PASSWORD_FILE="${STATE_DIR}/super_admin_initial_password"
REINSTALL_MARKER="${STATE_DIR}/.reinstall_from_config_files"
TPM_DEFERRED_MARKER="${STATE_DIR}/tpm_backend_deferred"
CORE_SYSTEMD_UNIT="vaulthalla.service"
# Shipped up to 1.6.6: an orphaned systemd listener on the daemon's CLI socket path that swallowed
# `vh` clients forever. vaulthalla.service owns /run/vaulthalla/cli.sock now; see retire_legacy_cli_units.
LEGACY_CLI_UNITS="vaulthalla-cli.socket vaulthalla-cli.service"
LEGACY_CLI_WANTS_LINKS="/etc/systemd/system/sockets.target.wants/vaulthalla-cli.socket /etc/systemd/system/multi-user.target.wants/vaulthalla-cli.service"
LEGACY_CLI_UNIT_DIRS="/lib/systemd/system /usr/lib/systemd/system"
DEB_SYSTEMD_HELPER_STATE_DIR="/var/lib/systemd"
CLI_SOCKET_PATH="/run/vaulthalla/cli.sock"
CLI_SOCKET_WAIT_SECONDS=15
WEB_SYSTEMD_UNIT="vaulthalla-web.service"
SWTPM_SYSTEMD_UNIT="vaulthalla-swtpm.service"
PSQL_DEPLOY_DIR="/usr/share/vaulthalla/psql"
NGINX_TEMPLATE="/usr/share/vaulthalla/nginx/vaulthalla"
NGINX_SITE_AVAIL="/etc/nginx/sites-available/vaulthalla"
NGINX_SITE_ENABLED="/etc/nginx/sites-enabled/vaulthalla"
NGINX_MANAGED_MARKER="${STATE_DIR}/nginx_site_managed"
NGINX_DEFAULT_SITE_AVAIL="/etc/nginx/sites-available/default"
NGINX_DEFAULT_SITE_ENABLED="/etc/nginx/sites-enabled/default"
NGINX_DEFAULT_DISABLED_MARKER="${STATE_DIR}/nginx_default_site_disabled"
SWTPM_BASE_DIR="/var/lib/swtpm"
SWTPM_STATE_DIR="${SWTPM_BASE_DIR}/vaulthalla"
TPM_BACKEND_OVERRIDE_DIR="/etc/systemd/system/vaulthalla.service.d"
TPM_BACKEND_OVERRIDE_FILE="${TPM_BACKEND_OVERRIDE_DIR}/tpm-backend.conf"
APPARMOR_SWTPM_PROFILE=""
APPARMOR_SWTPM_LOCAL_OVERRIDE=""

# Bounds for anything that talks to another daemon.
SYSTEMCTL_COMMAND_TIMEOUT_SECONDS=30
SERVICE_TRANSITION_TIMEOUT_SECONDS=60
SERVICE_KILL_SETTLE_SECONDS=15
PSQL_TIMEOUT_SECONDS=60
NGINX_TIMEOUT_SECONDS=30
UDEV_TIMEOUT_SECONDS=30
HTTP_PROBE_WINDOW_SECONDS=12
PGCONNECT_TIMEOUT_SECONDS=10

DB_BOOTSTRAP_STATUS="skipped"
NGINX_CONFIG_STATUS="skipped"
TPM_BACKEND_STATUS="unknown"
TPM_BACKEND_READY="1"
TPM_BACKEND_RECOVERED="0"
CONFIG_STATUS="unchanged"
SERVICE_STATUS="not changed"
CLI_SOCKET_STATUS="not checked (systemd is not running)"
LEGACY_CLI_UNITS_RETIRED="0"
# Expected to be running once configure finishes (it was running, failed, or was started here).
CORE_EXPECTED_UP="0"
DEGRADED_REASONS=""
PACKAGE_LOG="/var/log/vaulthalla-package.log"
PACKAGE_LOG_MAX_BYTES=1048576
PACKAGE_LOG_SINK="/dev/null"
POSTINST_ACTION="${1:-}"
LAST_CONFIGURED_VERSION="${2:-}"

# fresh: first install (or reinstall after purge)
# reinstall: install over config-files state left by `apt remove` (preinst marker)
# upgrade: normal upgrade / dpkg-reconfigure
INSTALL_MODE="fresh"
if [ -n "$LAST_CONFIGURED_VERSION" ]; then
    INSTALL_MODE="upgrade"
    if [ -f "$REINSTALL_MARKER" ]; then
        INSTALL_MODE="reinstall"
    fi
fi

create_dir() {
    # create_dir path mode owner group
    install -d -m "$2" -o "$3" -g "$4" "$1"
}

# Terminal output is operator status, not telemetry. Every step is appended to ${PACKAGE_LOG};
# detail() reaches the terminal only with VH_PACKAGE_VERBOSE=1, say()/warnings/errors always do,
# and the full summary is printed on fresh installs/reinstalls, after a hard failure
# (mark_degraded), or when verbose. A clean upgrade prints one status line, plus one when the
# operator has something to do.
package_verbose() {
    env_flag_enabled "${VH_PACKAGE_VERBOSE:-}"
}

open_package_log() {
    # The log lives in root-owned /var/log, never under the daemon-owned ${LOG_DIR}: a symlink planted
    # there would redirect root's appends. Logging is best effort and never fails configure.
    PACKAGE_LOG_SINK="/dev/null"
    if [ -L "$PACKAGE_LOG" ] || { [ -e "$PACKAGE_LOG" ] && [ ! -f "$PACKAGE_LOG" ]; }; then
        return 0
    fi
    log_size="$(stat -c %s "$PACKAGE_LOG" 2>/dev/null || echo 0)"
    if [ "${log_size:-0}" -gt "$PACKAGE_LOG_MAX_BYTES" ]; then
        mv -f "$PACKAGE_LOG" "${PACKAGE_LOG}.1" 2>/dev/null || true
    fi
    if ! ( umask 027; : >> "$PACKAGE_LOG" ) 2>/dev/null; then
        return 0
    fi
    chgrp adm "$PACKAGE_LOG" 2>/dev/null || true
    chmod 0640 "$PACKAGE_LOG" 2>/dev/null || true
    PACKAGE_LOG_SINK="$PACKAGE_LOG"
    log_line "==== $(date -u '+%Y-%m-%dT%H:%M:%SZ') ${PKG} postinst ${POSTINST_ACTION} (mode ${INSTALL_MODE}, previous '${LAST_CONFIGURED_VERSION}') ===="
}

log_line() {
    if [ "$PACKAGE_LOG_SINK" != "/dev/null" ]; then
        printf '%s\n' "$*" >> "$PACKAGE_LOG_SINK" 2>/dev/null || true
    fi
}

log_stdin() {
    while IFS= read -r log_stdin_line; do
        log_line "$log_stdin_line"
    done
}

detail() {
    log_line "$*"
    if package_verbose; then
        echo "[${PKG}] $*"
    fi
}

say() {
    log_line "$*"
    echo "[${PKG}] $*"
}

say_err() {
    log_line "$*"
    echo "[${PKG}] $*" >&2
}

warn_nonfatal() {
    say_err "WARNING: $*"
}

report_error() {
    say_err "ERROR: $*"
}

mark_degraded() {
    # A hard failure the operator must see: the full summary is printed at the end of configure.
    log_line "DEGRADED: $*"
    DEGRADED_REASONS="${DEGRADED_REASONS:+${DEGRADED_REASONS}; }$*"
}

is_upgrade() {
    [ "$POSTINST_ACTION" = "configure" ] && [ "$INSTALL_MODE" = "upgrade" ]
}

has_command() {
    command -v "$1" >/dev/null 2>&1
}

run_bounded() {
    # run_bounded <seconds> <command...>: never let a helper block configure forever.
    limit="$1"
    shift
    if has_command timeout; then
        timeout --kill-after=5 "$limit" "$@"
        return $?
    fi
    "$@"
}

systemd_running() {
    has_command systemctl && [ -d /run/systemd/system ]
}

run_systemctl_quiet() {
    run_bounded "$SYSTEMCTL_COMMAND_TIMEOUT_SECONDS" systemctl --system "$@" >/dev/null 2>&1
}

safe_systemctl() {
    # Runtime systemctl actions; skipped when systemd is not PID 1 (containers, chroots).
    if ! systemd_running; then
        return 0
    fi
    run_systemctl_quiet "$@" || true
}

safe_systemctl_unit_files() {
    # Unit-file operations (enable/disable) also work offline, so only systemctl is required.
    if ! has_command systemctl; then
        return 0
    fi
    run_bounded "$SYSTEMCTL_COMMAND_TIMEOUT_SECONDS" systemctl --system "$@" >>"$PACKAGE_LOG_SINK" 2>&1 || true
}

unit_active_state() {
    state="$(run_bounded 10 systemctl --system show -p ActiveState --value "$1" 2>/dev/null || true)"
    printf '%s' "${state:-unknown}"
}

wait_for_unit_to_settle() {
    unit="$1"
    limit="$2"
    waited=0
    while [ "$waited" -lt "$limit" ]; do
        case "$(unit_active_state "$unit")" in
            deactivating|activating|reloading)
                ;;
            *)
                return 0
                ;;
        esac
        sleep 1
        waited=$((waited + 1))
    done
    return 1
}

transition_unit_bounded() {
    # transition_unit_bounded <verb> <unit>: start/restart/try-restart with a hard bound.
    # A unit that exceeds the bound is killed (cgroup-scoped, never by process name) and
    # configure continues; a slow or failing service never fails the package operation.
    verb="$1"
    unit="$2"
    if ! systemd_running; then
        return 0
    fi

    # A unit that hit StartLimitBurst refuses manual starts until reset.
    if [ "$(unit_active_state "$unit")" = "failed" ]; then
        run_systemctl_quiet reset-failed "$unit" || true
    fi

    if run_bounded "$SERVICE_TRANSITION_TIMEOUT_SECONDS" systemctl --system "$verb" "$unit" >>"$PACKAGE_LOG_SINK" 2>&1; then
        return 0
    else
        rc=$?
    fi

    case "$rc" in
        124|137)
            warn_nonfatal "${unit}: '${verb}' did not finish within ${SERVICE_TRANSITION_TIMEOUT_SECONDS}s; sending SIGKILL to the unit cgroup."
            run_systemctl_quiet kill -s KILL "$unit" || true
            if ! wait_for_unit_to_settle "$unit" "$SERVICE_KILL_SETTLE_SECONDS"; then
                warn_nonfatal "${unit}: still transitioning after SIGKILL; continuing. Check: systemctl status ${unit}"
            fi
            ;;
        *)
            warn_nonfatal "${unit}: 'systemctl ${verb}' failed (exit ${rc}); continuing. Check: journalctl -u ${unit}"
            ;;
    esac
    return 0
}

mountinfo_escape_path() {
    # /proc/self/mountinfo octal-escapes space, tab, newline and backslash.
    printf '%s' "$1" | sed -e 's/\\/\\134/g' -e 's/ /\\040/g' -e 's/	/\\011/g'
}

is_mountpoint() {
    # Parse the kernel mount table instead of calling mountpoint/stat: any syscall on a
    # live FUSE mount blocks forever when the daemon is wedged.
    VH_MOUNTINFO_TARGET="$(mountinfo_escape_path "$1")"
    export VH_MOUNTINFO_TARGET
    if [ -r /proc/self/mountinfo ]; then
        awk '$5 == ENVIRON["VH_MOUNTINFO_TARGET"] { found = 1 } END { exit(found ? 0 : 1) }' /proc/self/mountinfo
        return $?
    fi
    if [ -r /proc/mounts ]; then
        awk '$2 == ENVIRON["VH_MOUNTINFO_TARGET"] { found = 1 } END { exit(found ? 0 : 1) }' /proc/mounts
        return $?
    fi
    return 1
}

ensure_mount_root() {
    # FUSE mount roots can reject chown/chmod while live or stale; never let that
    # abort package configuration. The mounted check must come first: it is the
    # only probe that cannot block on a wedged FUSE daemon.
    path="$1"
    mode="$2"
    owner="$3"
    group="$4"

    if is_mountpoint "$path"; then
        detail "Mount root ${path}: mounted; leaving owner/mode unchanged."
        return 0
    fi

    if [ -d "$path" ]; then
        detail "Mount root ${path}: exists; leaving owner/mode unchanged."
        return 0
    fi

    if create_dir "$path" "$mode" "$owner" "$group"; then
        detail "Mount root ${path}: created."
        return 0
    fi

    warn_nonfatal "Could not prepare mount root ${path}; continuing."
    return 0
}

run_as_postgres() {
    # Bounded, and PGCONNECT_TIMEOUT is passed explicitly because sudo resets the environment.
    if has_command runuser; then
        run_bounded "$PSQL_TIMEOUT_SECONDS" runuser -u postgres -- env PGCONNECT_TIMEOUT="$PGCONNECT_TIMEOUT_SECONDS" "$@"
        return $?
    fi
    if has_command sudo; then
        run_bounded "$PSQL_TIMEOUT_SECONDS" sudo -n -u postgres env PGCONNECT_TIMEOUT="$PGCONNECT_TIMEOUT_SECONDS" "$@"
        return $?
    fi
    return 1
}

env_flag_enabled() {
    case "$1" in
        1|true|TRUE|yes|YES|on|ON)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

psql_q() {
    # psql_q "SQL" [database] -- never pass secrets here (argv is world-readable).
    run_as_postgres psql -X -q -v ON_ERROR_STOP=1 -tA -d "${2:-postgres}" -c "$1"
}

psql_stdin() {
    # psql_stdin database < sql -- the channel for anything containing a secret.
    run_as_postgres psql -X -q -v ON_ERROR_STOP=1 -d "$1"
}

postgresql_server_ready() {
    if has_command pg_isready; then
        run_as_postgres pg_isready -q >/dev/null 2>&1
        return $?
    fi
    psql_q 'SELECT 1' >/dev/null 2>&1
}

ensure_tss_group_and_user_added() {
    if getent group tss > /dev/null; then
        detail "Ensuring '${DB_USER}' is a member of the existing 'tss' group."
    else
        detail "No 'tss' group found; creating one."
        if ! addgroup --system tss; then
            warn_nonfatal "Failed to create 'tss' group; continuing without package-time TPM group membership."
            return 0
        fi
    fi
    if id -nG "$DB_USER" 2>/dev/null | tr ' ' '\n' | grep -qx tss; then
        return 0
    fi
    if ! adduser "$DB_USER" tss; then
        warn_nonfatal "Failed to add '${DB_USER}' to 'tss'; continuing because systemd supplies SupplementaryGroups=tss."
        return 0
    fi
}

align_config_file_permissions() {
    target="$1"
    if [ ! -f "$target" ]; then
        return 0
    fi
    if ! chown "$DB_USER:$DB_USER" "$target"; then
        warn_nonfatal "Could not align owner for ${target}; leaving unchanged."
    fi
    if ! chmod 0640 "$target"; then
        warn_nonfatal "Could not align mode for ${target}; leaving unchanged."
    fi
}

install_file_atomically() {
    # install_file_atomically src dst: write a sibling temp file, then rename over dst.
    src="$1"
    dst="$2"
    tmp="${dst}.dpkg-vh-new"
    if install -m 0640 -o "$DB_USER" -g "$DB_USER" "$src" "$tmp" && mv -f "$tmp" "$dst"; then
        return 0
    fi
    rm -f "$tmp" 2>/dev/null || true
    return 1
}

install_default_config_if_missing() {
    # /etc/vaulthalla/config.yaml is operator/daemon-owned state, not a dpkg conffile: the
    # daemon and `vh setup remote-db` rewrite it. The packaged default lives in
    # /usr/share/vaulthalla/config and is copied only when /etc has no config at all.
    # Upgrades from releases that shipped it as a conffile keep the existing file untouched.
    packaged_config="${PACKAGED_CONFIG_DIR}/config.yaml"
    packaged_template="${PACKAGED_CONFIG_DIR}/config_template.yaml.in"

    install -d -m 0755 "$CONFIG_DIR"

    if [ -e "$CONFIG_FILE" ] || [ -L "$CONFIG_FILE" ]; then
        CONFIG_STATUS="preserved existing ${CONFIG_FILE}"
    elif [ ! -f "$packaged_config" ]; then
        CONFIG_STATUS="missing (packaged default ${packaged_config} not found)"
        warn_nonfatal "Packaged default config ${packaged_config} is missing; ${CONFIG_FILE} was not created."
    elif install_file_atomically "$packaged_config" "$CONFIG_FILE"; then
        CONFIG_STATUS="installed default ${CONFIG_FILE}"
        detail "Config: installed default ${CONFIG_FILE} from ${packaged_config}."
    else
        CONFIG_STATUS="failed installing default ${CONFIG_FILE}"
        warn_nonfatal "Could not install ${CONFIG_FILE}; continuing."
    fi

    # The template is a package-owned reference (read by the daemon only when config.yaml
    # is missing), so it is refreshed on every configure.
    if [ -f "$packaged_template" ]; then
        if ! install_file_atomically "$packaged_template" "$CONFIG_TEMPLATE_FILE"; then
            warn_nonfatal "Could not refresh ${CONFIG_TEMPLATE_FILE}; continuing."
        fi
    fi
}

ensure_fuse_allow_other() {
    fuse_conf="/etc/fuse.conf"
    if [ ! -f "$fuse_conf" ]; then
        if ! install -m 0644 /dev/null "$fuse_conf"; then
            warn_nonfatal "Could not create ${fuse_conf}; skipping FUSE allow_other configuration."
            return 0
        fi
    fi

    if grep -Eq '^[[:space:]]*user_allow_other([[:space:]]*(#.*)?)?$' "$fuse_conf"; then
        detail "FUSE config: user_allow_other already enabled"
        return 0
    fi

    if grep -Eq '^[[:space:]]*#[[:space:]]*user_allow_other([[:space:]]*(#.*)?)?$' "$fuse_conf"; then
        if ! sed -i -E 's/^[[:space:]]*#[[:space:]]*(user_allow_other([[:space:]]*(#.*)?)?)$/\1/' "$fuse_conf"; then
            warn_nonfatal "Could not update ${fuse_conf}; skipping FUSE allow_other configuration."
            return 0
        fi
        detail "FUSE config: enabled user_allow_other in /etc/fuse.conf"
        return 0
    fi

    if ! printf '\nuser_allow_other\n' >> "$fuse_conf"; then
        warn_nonfatal "Could not append to ${fuse_conf}; skipping FUSE allow_other configuration."
        return 0
    fi
    detail "FUSE config: enabled user_allow_other in /etc/fuse.conf"
}

require_runtime_assets() {
    if [ ! -d "$PSQL_DEPLOY_DIR" ]; then
        report_error "Required SQL deploy directory is missing: ${PSQL_DEPLOY_DIR}"
        exit 1
    fi

    if ! find "$PSQL_DEPLOY_DIR" -maxdepth 1 -type f -name '*.sql' | grep -q .; then
        report_error "SQL deploy directory is empty: ${PSQL_DEPLOY_DIR}"
        exit 1
    fi
}

refresh_tpm_udev_rules() {
    if ! has_command udevadm; then
        return 0
    fi
    run_bounded "$UDEV_TIMEOUT_SECONDS" udevadm control --reload-rules >/dev/null 2>&1 || true
    run_bounded "$UDEV_TIMEOUT_SECONDS" udevadm trigger --subsystem-match=tpm >/dev/null 2>&1 || true
}

has_hardware_tpm() {
    [ -c /dev/tpmrm0 ] || [ -c /dev/tpm0 ]
}

swtpm_listening_locally() {
    if ! has_command ss; then
        return 0
    fi
    attempts=0
    while [ "$attempts" -lt 5 ]; do
        if ss -H -ltn '( sport = :2321 )' 2>/dev/null | grep -q '127.0.0.1:2321'; then
            return 0
        fi
        attempts=$((attempts + 1))
        sleep 1
    done
    return 1
}

clear_tpm_backend_override() {
    rm -f "$TPM_BACKEND_OVERRIDE_FILE"
}

write_swtpm_tcti_override() {
    install -d -m 0755 "$TPM_BACKEND_OVERRIDE_DIR"
    cat > "$TPM_BACKEND_OVERRIDE_FILE" <<EOF
[Service]
Environment=TSS2_TCTI=swtpm:host=127.0.0.1,port=2321
EOF
    chmod 0644 "$TPM_BACKEND_OVERRIDE_FILE"
}

find_swtpm_apparmor_profile() {
    APPARMOR_SWTPM_PROFILE=""
    for candidate in /etc/apparmor.d/usr.bin.swtpm /etc/apparmor.d/swtpm; do
        if [ -f "$candidate" ]; then
            APPARMOR_SWTPM_PROFILE="$candidate"
            return 0
        fi
    done
    return 1
}

resolve_swtpm_apparmor_local_override() {
    profile_path="$1"
    APPARMOR_SWTPM_LOCAL_OVERRIDE=""
    include_rel="$(sed -n 's/^[[:space:]]*#include[[:space:]]*<\(local\/[^>]*\)>.*/\1/p' "$profile_path" | head -n 1)"
    if [ -n "$include_rel" ]; then
        APPARMOR_SWTPM_LOCAL_OVERRIDE="/etc/apparmor.d/${include_rel}"
        return 0
    fi

    case "$(basename "$profile_path")" in
        usr.bin.swtpm)
            APPARMOR_SWTPM_LOCAL_OVERRIDE="/etc/apparmor.d/local/usr.bin.swtpm"
            ;;
        swtpm)
            APPARMOR_SWTPM_LOCAL_OVERRIDE="/etc/apparmor.d/local/swtpm"
            ;;
        *)
            APPARMOR_SWTPM_LOCAL_OVERRIDE="/etc/apparmor.d/local/usr.bin.swtpm"
            ;;
    esac
    return 0
}

append_unique_line() {
    target_file="$1"
    target_line="$2"
    if grep -Fqx "$target_line" "$target_file" 2>/dev/null; then
        return 0
    fi
    printf '%s\n' "$target_line" >> "$target_file"
    APPARMOR_OVERRIDE_CHANGED="1"
}

configure_swtpm_apparmor_override_if_possible() {
    APPARMOR_OVERRIDE_CHANGED="0"

    if [ ! -d /sys/module/apparmor ]; then
        detail "AppArmor module not detected; skipping swtpm AppArmor override handling."
        return 1
    fi

    if ! find_swtpm_apparmor_profile; then
        detail "swtpm AppArmor profile not found; skipping local override."
        return 1
    fi
    resolve_swtpm_apparmor_local_override "$APPARMOR_SWTPM_PROFILE"
    install -d -m 0755 "$(dirname "$APPARMOR_SWTPM_LOCAL_OVERRIDE")"
    if [ ! -f "$APPARMOR_SWTPM_LOCAL_OVERRIDE" ]; then
        : > "$APPARMOR_SWTPM_LOCAL_OVERRIDE"
        chmod 0644 "$APPARMOR_SWTPM_LOCAL_OVERRIDE"
    fi

    append_unique_line "$APPARMOR_SWTPM_LOCAL_OVERRIDE" "# Allow Vaulthalla-managed swtpm state."
    append_unique_line "$APPARMOR_SWTPM_LOCAL_OVERRIDE" "${SWTPM_STATE_DIR}/ rw,"
    append_unique_line "$APPARMOR_SWTPM_LOCAL_OVERRIDE" "${SWTPM_STATE_DIR}/** rwk,"

    if [ "$APPARMOR_OVERRIDE_CHANGED" = "1" ]; then
        detail "Installed swtpm AppArmor local override at ${APPARMOR_SWTPM_LOCAL_OVERRIDE}."
    else
        detail "swtpm AppArmor local override already includes Vaulthalla state rules."
    fi

    if ! has_command apparmor_parser; then
        warn_nonfatal "apparmor_parser is unavailable; cannot reload swtpm AppArmor profile."
        return 1
    fi

    if ! run_bounded 60 apparmor_parser -r "$APPARMOR_SWTPM_PROFILE" >/dev/null 2>&1; then
        warn_nonfatal "Failed to reload AppArmor profile: ${APPARMOR_SWTPM_PROFILE}"
        return 1
    fi

    detail "Reloaded AppArmor profile: ${APPARMOR_SWTPM_PROFILE}."
    return 0
}

start_and_validate_swtpm_service() {
    if ! run_bounded "$SERVICE_TRANSITION_TIMEOUT_SECONDS" systemctl --system enable --now "$SWTPM_SYSTEMD_UNIT" >/dev/null 2>&1; then
        return 1
    fi
    if ! run_systemctl_quiet --quiet is-active "$SWTPM_SYSTEMD_UNIT"; then
        return 1
    fi
    if ! swtpm_listening_locally; then
        return 1
    fi
    return 0
}

defer_tpm_backend() {
    # No usable TPM backend is not a package failure: configure completes, the core
    # daemon is left stopped (it cannot seal secrets), and a marker remembers to finish
    # provisioning on the next configure run.
    TPM_BACKEND_STATUS="deferred ($1)"
    mark_degraded "TPM backend unavailable ($1)"
    TPM_BACKEND_READY="0"
    printf '%s\n' "reason=$1" > "$TPM_DEFERRED_MARKER" 2>/dev/null || true
    warn_nonfatal "TPM backend unavailable: $1."
    warn_nonfatal "vaulthalla.service will not be started until a TPM backend is available."
    warn_nonfatal "Fix: install a TPM backend and re-run configuration:"
    warn_nonfatal "  sudo apt install swtpm swtpm-tools && sudo dpkg-reconfigure vaulthalla"
}

configure_tpm_backend_if_safe() {
    tpm_was_deferred="0"
    if [ -f "$TPM_DEFERRED_MARKER" ]; then
        tpm_was_deferred="1"
    fi

    if has_hardware_tpm; then
        TPM_BACKEND_STATUS="hardware (device-backed TPM detected)"
        detail "TPM backend: hardware TPM detected (/dev/tpmrm0 or /dev/tpm0)."
        clear_tpm_backend_override
        safe_systemctl stop "$SWTPM_SYSTEMD_UNIT"
        safe_systemctl_unit_files disable "$SWTPM_SYSTEMD_UNIT"
        rm -f "$TPM_DEFERRED_MARKER"
        TPM_BACKEND_RECOVERED="$tpm_was_deferred"
        return 0
    fi

    detail "TPM backend: no hardware TPM detected; provisioning Vaulthalla swtpm backend."

    if ! has_command swtpm; then
        defer_tpm_backend "no hardware TPM and swtpm not installed"
        return 0
    fi

    create_dir "$SWTPM_BASE_DIR" 755 root root
    create_dir "$SWTPM_STATE_DIR" 700 "$DB_USER" "$DB_USER"
    write_swtpm_tcti_override

    if is_upgrade && [ "$tpm_was_deferred" = "0" ]; then
        TPM_BACKEND_STATUS="swtpm configured (upgrade; active unit restart handled separately)"
        detail "TPM backend: swtpm fallback prepared; active unit restart is handled by configure_systemd_units."
        return 0
    fi

    if ! systemd_running; then
        TPM_BACKEND_STATUS="swtpm configured (systemd not running; runtime activation not verified)"
        detail "systemd is not running; cannot verify ${SWTPM_SYSTEMD_UNIT} runtime state."
        rm -f "$TPM_DEFERRED_MARKER"
        return 0
    fi

    if ! run_systemctl_quiet daemon-reload; then
        defer_tpm_backend "failed daemon-reload for swtpm backend"
        return 0
    fi

    if start_and_validate_swtpm_service; then
        TPM_BACKEND_STATUS="swtpm (managed fallback active)"
        detail "TPM backend: managed swtpm fallback active."
        rm -f "$TPM_DEFERRED_MARKER"
        TPM_BACKEND_RECOVERED="$tpm_was_deferred"
        return 0
    fi

    detail "${SWTPM_SYSTEMD_UNIT} failed initial start; checking AppArmor local override path."

    if configure_swtpm_apparmor_override_if_possible; then
        run_systemctl_quiet reset-failed "$SWTPM_SYSTEMD_UNIT" || true
        if start_and_validate_swtpm_service; then
            TPM_BACKEND_STATUS="swtpm (managed fallback active; AppArmor local override applied)"
            detail "TPM backend: managed swtpm fallback active after AppArmor override reload."
            rm -f "$TPM_DEFERRED_MARKER"
            TPM_BACKEND_RECOVERED="$tpm_was_deferred"
            return 0
        fi
    fi

    warn_nonfatal "Check logs with: journalctl -u ${SWTPM_SYSTEMD_UNIT}"
    if [ -n "$APPARMOR_SWTPM_LOCAL_OVERRIDE" ]; then
        warn_nonfatal "Check AppArmor local override: ${APPARMOR_SWTPM_LOCAL_OVERRIDE}"
    fi
    warn_nonfatal "Last-resort debug command (not default packaging behavior):"
    warn_nonfatal "  sudo aa-complain swtpm || sudo aa-complain /usr/bin/swtpm"
    defer_tpm_backend "failed to start ${SWTPM_SYSTEMD_UNIT}"
    return 0
}

is_noninteractive_context() {
    if [ "${DEBIAN_FRONTEND:-}" = "noninteractive" ]; then
        return 0
    fi
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        return 0
    fi
    if ! ( : </dev/tty ) 2>/dev/null; then
        return 0
    fi
    return 1
}

read_interactive_line() {
    # EOF leaves INTERACTIVE_INPUT empty, which every caller treats as "abort".
    INTERACTIVE_INPUT=""
    IFS= read -r INTERACTIVE_INPUT </dev/tty || true
}

sealed_db_secret_present() {
    # TPMKeyProvider("psql") seals to <backing path>/.sealed_psql.blob/psql.{priv,pub}.
    [ -f "${SEALED_DB_SECRET_DIR}/psql.priv" ]
}

pending_db_seed_present() {
    [ -s "$PENDING_DB_PASS_FILE" ]
}

read_pending_db_password() {
    # The daemon reads the first whitespace-delimited token.
    PENDING_DB_PASSWORD="$(sed -n '1p' "$PENDING_DB_PASS_FILE" 2>/dev/null | awk '{ print $1 }')"
    [ -n "$PENDING_DB_PASSWORD" ]
}

write_pending_db_password() {
    # Atomic handoff: temp file (mktemp creates 0600) + rename, so a crash never leaves a
    # partially written seed and the password never appears in argv.
    db_password="$1"
    create_dir "$RUNTIME_DIR" 0750 "$DB_USER" "$DB_USER" || return 1
    tmp_seed="$(mktemp "${PENDING_DB_PASS_FILE}.XXXXXX")" || return 1
    if ! printf '%s\n' "$db_password" > "$tmp_seed"; then
        rm -f "$tmp_seed"
        return 1
    fi
    if ! chown "$DB_USER:$DB_USER" "$tmp_seed" || ! chmod 0600 "$tmp_seed" || ! mv -f "$tmp_seed" "$PENDING_DB_PASS_FILE"; then
        rm -f "$tmp_seed"
        return 1
    fi
    return 0
}

generate_db_password() {
    # Hex keeps the value safe for libpq connection strings and SQL literals alike.
    openssl rand -hex 32 | tr -d '\n'
}

sql_escape_literal() {
    printf '%s' "$1" | sed "s/'/''/g"
}

configured_db_host() {
    # database.host from /etc/vaulthalla/config.yaml (two-space indented block key).
    if [ ! -r "$CONFIG_FILE" ]; then
        return 0
    fi
    awk '
        /^[^[:space:]#]/ { in_db = ($0 ~ /^database:[[:space:]]*(#.*)?$/); next }
        in_db && /^  host:/ {
            value = $0
            sub(/^  host:[[:space:]]*/, "", value)
            sub(/[[:space:]]+#.*$/, "", value)
            sub(/[[:space:]]+$/, "", value)
            gsub(/^["\047]|["\047]$/, "", value)
            print value
            exit
        }
    ' "$CONFIG_FILE" 2>/dev/null || true
}

configured_db_is_local() {
    db_host="$(configured_db_host)"
    case "$db_host" in
        ""|localhost|127.*|::1|"[::1]"|/*)
            return 0
            ;;
    esac
    return 1
}

query_local_db_state() {
    # Sets ROLE_EXISTS / DB_EXISTS ("1" or ""); returns non-zero when PostgreSQL can't be queried.
    if ! ROLE_EXISTS="$(psql_q "SELECT 1 FROM pg_roles WHERE rolname='${DB_USER}'")"; then
        return 1
    fi
    ROLE_EXISTS="$(printf '%s' "$ROLE_EXISTS" | tr -d '[:space:]')"
    if ! DB_EXISTS="$(psql_q "SELECT 1 FROM pg_database WHERE datname='${DB_NAME}'")"; then
        return 1
    fi
    DB_EXISTS="$(printf '%s' "$DB_EXISTS" | tr -d '[:space:]')"
    return 0
}

detect_local_db_data_state() {
    # DB_DATA_STATE: empty | present | unknown. Once the daemon has started even once,
    # initdb has seeded principals into public.users, so an empty/missing users table
    # means an interrupted install that never ran the service.
    DB_DATA_STATE="empty"
    if [ "$DB_EXISTS" != "1" ]; then
        return 0
    fi
    if ! users_table="$(psql_q "SELECT to_regclass('public.users') IS NOT NULL" "$DB_NAME")"; then
        DB_DATA_STATE="unknown"
        return 0
    fi
    users_table="$(printf '%s' "$users_table" | tr -d '[:space:]')"
    if [ "$users_table" != "t" ]; then
        return 0
    fi
    if ! users_rows="$(psql_q "SELECT EXISTS (SELECT 1 FROM public.users)" "$DB_NAME")"; then
        DB_DATA_STATE="unknown"
        return 0
    fi
    users_rows="$(printf '%s' "$users_rows" | tr -d '[:space:]')"
    if [ "$users_rows" = "t" ]; then
        DB_DATA_STATE="present"
    fi
    return 0
}

converge_local_db() {
    # converge_local_db <password> <seed-already-written:0|1>
    # Idempotent: seed first (atomically), then make the role/database match it. A rerun
    # after an interruption finds the seed and converges to the same password.
    db_password="$1"
    seed_written="$2"
    escaped_password="$(sql_escape_literal "$db_password")"
    role_created="0"

    if [ "$seed_written" != "1" ]; then
        if ! write_pending_db_password "$db_password"; then
            DB_BOOTSTRAP_STATUS="failed (could not write runtime DB password handoff ${PENDING_DB_PASS_FILE})"
            return 1
        fi
    fi

    if [ "$ROLE_EXISTS" = "1" ]; then
        if ! psql_stdin postgres <<EOF
ALTER ROLE ${DB_USER} WITH LOGIN PASSWORD '${escaped_password}';
EOF
        then
            DB_BOOTSTRAP_STATUS="failed (could not set password for PostgreSQL role '${DB_USER}')"
            rm -f "$PENDING_DB_PASS_FILE"
            return 1
        fi
    else
        if ! psql_stdin postgres <<EOF
CREATE ROLE ${DB_USER} LOGIN PASSWORD '${escaped_password}';
EOF
        then
            DB_BOOTSTRAP_STATUS="failed (could not create PostgreSQL role '${DB_USER}')"
            rm -f "$PENDING_DB_PASS_FILE"
            return 1
        fi
        ROLE_EXISTS="1"
        role_created="1"
        detail "Created PostgreSQL role '${DB_USER}'."
    fi

    if [ "$DB_EXISTS" != "1" ]; then
        if ! psql_q "CREATE DATABASE ${DB_NAME} OWNER ${DB_USER}" >/dev/null; then
            DB_BOOTSTRAP_STATUS="failed (could not create PostgreSQL database '${DB_NAME}')"
            rm -f "$PENDING_DB_PASS_FILE"
            return 1
        fi
        DB_EXISTS="1"
        detail "Created PostgreSQL database '${DB_NAME}'."
    elif [ "$role_created" = "1" ]; then
        psql_q "ALTER DATABASE ${DB_NAME} OWNER TO ${DB_USER}" >/dev/null 2>&1 || true
    fi

    if ! psql_q "GRANT ALL PRIVILEGES ON DATABASE ${DB_NAME} TO ${DB_USER}" >/dev/null; then
        DB_BOOTSTRAP_STATUS="failed (could not grant database privileges to '${DB_USER}')"
        rm -f "$PENDING_DB_PASS_FILE"
        return 1
    fi
    psql_q "GRANT USAGE, CREATE ON SCHEMA public TO ${DB_USER}" "$DB_NAME" >/dev/null 2>&1 || true
    return 0
}

perform_fresh_local_db_bootstrap() {
    if ! has_command openssl; then
        DB_BOOTSTRAP_STATUS="skipped (openssl not installed for role password generation)"
        return 0
    fi
    if converge_local_db "$(generate_db_password)" 0; then
        DB_BOOTSTRAP_STATUS="done (created local DB role/database and seeded runtime password handoff at ${PENDING_DB_PASS_FILE})"
    fi
    return 0
}

resume_local_db_bootstrap_from_seed() {
    if ! read_pending_db_password; then
        DB_BOOTSTRAP_STATUS="failed (pending ${PENDING_DB_PASS_FILE} is unreadable or empty)"
        return 0
    fi
    if converge_local_db "$PENDING_DB_PASSWORD" 1; then
        DB_BOOTSTRAP_STATUS="done (resumed from pending runtime password handoff ${PENDING_DB_PASS_FILE})"
    fi
    return 0
}

print_existing_db_resolution_commands() {
    printf '%s\n' "  Keep the existing data (rotate the role password and hand it to Vaulthalla):"
    printf '%s\n' "    sudo env VH_EXISTING_DB_ACTION=adopt dpkg --configure -a"
    printf '%s\n' "  Permanently delete the existing database and role, then start fresh:"
    printf '%s\n' "    sudo env VH_EXISTING_DB_ACTION=overwrite dpkg --configure -a"
    printf '%s\n' "  (For a package that is already configured, use 'dpkg-reconfigure vaulthalla'"
    printf '%s\n' "   instead of 'dpkg --configure -a'.)"
}

print_adopt_key_warning() {
    warn_nonfatal "Adopting an existing Vaulthalla database without its sealed secrets."
    warn_nonfatal "Users, vault metadata and settings are kept, but vault encryption keys and"
    warn_nonfatal "stored provider API keys in that database are only recoverable if the original"
    warn_nonfatal "${STATE_DIR}/.sealed_*.blob files AND the same TPM are restored. Without them,"
    warn_nonfatal "encrypted vault content and stored API keys cannot be decrypted."
}

adopt_existing_local_db() {
    if ! has_command openssl; then
        DB_BOOTSTRAP_STATUS="failed (openssl not installed for role password generation)"
        return 0
    fi
    print_adopt_key_warning
    if converge_local_db "$(generate_db_password)" 0; then
        DB_BOOTSTRAP_STATUS="done (adopted existing DB; rotated role password and seeded ${PENDING_DB_PASS_FILE})"
        say "Adopted existing PostgreSQL database '${DB_NAME}' (role password rotated)."
    fi
    return 0
}

drop_local_db_and_role() {
    # Separate statements: DROP DATABASE cannot run inside a (multi-statement) transaction.
    if [ "$DB_EXISTS" = "1" ]; then
        server_version="$(psql_q "SHOW server_version_num" 2>/dev/null | tr -d '[:space:]' || true)"
        case "$server_version" in
            ''|*[!0-9]*) server_version=0 ;;
        esac
        if [ "$server_version" -ge 130000 ]; then
            psql_q "DROP DATABASE IF EXISTS ${DB_NAME} WITH (FORCE)" >/dev/null || return 1
        else
            psql_q "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='${DB_NAME}' AND pid <> pg_backend_pid()" >/dev/null 2>&1 || true
            psql_q "DROP DATABASE IF EXISTS ${DB_NAME}" >/dev/null || return 1
        fi
        DB_EXISTS=""
    fi
    if [ "$ROLE_EXISTS" = "1" ]; then
        if psql_q "DROP ROLE IF EXISTS ${DB_USER}" >/dev/null; then
            ROLE_EXISTS=""
        else
            # The role may own objects in other databases; keep it and rotate its password.
            warn_nonfatal "Could not drop PostgreSQL role '${DB_USER}'; it will be kept and its password rotated."
        fi
    fi
    return 0
}

overwrite_existing_local_db() {
    say "Dropping existing PostgreSQL database/role '${DB_NAME}' before a fresh bootstrap."
    if ! drop_local_db_and_role; then
        DB_BOOTSTRAP_STATUS="failed (could not drop existing PostgreSQL database '${DB_NAME}')"
        report_error "Failed to drop the existing Vaulthalla database; nothing else was changed."
        print_existing_db_resolution_commands >&2
        exit 1
    fi
    perform_fresh_local_db_bootstrap
    if [ "${DB_BOOTSTRAP_STATUS#done}" != "$DB_BOOTSTRAP_STATUS" ]; then
        DB_BOOTSTRAP_STATUS="done (existing DB overwritten; fresh role/database created and runtime password seeded)"
    fi
    return 0
}

abort_for_existing_db() {
    reason="$1"
    report_error "An existing Vaulthalla PostgreSQL database was found (role/database '${DB_NAME}'),"
    report_error "but this host has no sealed credential for it (${SEALED_DB_SECRET_DIR})"
    report_error "and no pending ${PENDING_DB_PASS_FILE}. This usually means Vaulthalla was purged"
    report_error "and reinstalled. Configuration stopped (${reason}); PostgreSQL was not changed."
    say_err "Resolve it with one of:"
    print_existing_db_resolution_commands >&2
    print_existing_db_resolution_commands | log_stdin
    say_err "Adopting keeps users and vault metadata, but vault encryption keys and stored API keys"
    say_err "are only recoverable if the original ${STATE_DIR}/.sealed_*.blob files and TPM are restored."
    exit 1
}

prompt_existing_db_action() {
    printf '\n%s\n' "An existing Vaulthalla PostgreSQL database was found, but this host has no sealed"
    printf '%s\n\n' "credential for it (usually: Vaulthalla was purged and is being reinstalled)."
    printf '%s\n' "  [a] adopt      keep the data; rotate the role password and hand it to Vaulthalla"
    printf '%s\n' "                 (vault encryption keys / stored API keys stay unreadable unless the"
    printf '%s\n' "                 original ${STATE_DIR}/.sealed_*.blob files and TPM are restored)"
    printf '%s\n' "  [o] overwrite  permanently delete the database and role, then start fresh"
    printf '%s\n\n' "  [b] abort      stop configuration now without changing PostgreSQL"
    printf '%s' "Choose [a]dopt / [o]verwrite / a[b]ort: "
    read_interactive_line
    choice="$(printf '%s' "$INTERACTIVE_INPUT" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
    case "$choice" in
        a|adopt)
            EXISTING_DB_ACTION="adopt"
            ;;
        o|overwrite)
            confirm_phrase="DROP VAULTHALLA DATABASE"
            printf '\n%s\n' "Type the following phrase exactly to confirm the destructive overwrite:"
            printf '%s\n' "  ${confirm_phrase}"
            printf '%s' "Confirmation: "
            read_interactive_line
            if [ "$INTERACTIVE_INPUT" = "$confirm_phrase" ]; then
                EXISTING_DB_ACTION="overwrite"
            else
                EXISTING_DB_ACTION="abort"
                EXISTING_DB_ACTION_REASON="overwrite confirmation phrase did not match"
            fi
            ;;
        *)
            # b, EOF, or anything unrecognized: abort without looping.
            EXISTING_DB_ACTION="abort"
            EXISTING_DB_ACTION_REASON="operator chose abort"
            ;;
    esac
}

resolve_existing_db_action() {
    EXISTING_DB_ACTION=""
    EXISTING_DB_ACTION_REASON=""
    case "${VH_EXISTING_DB_ACTION:-}" in
        adopt|overwrite|abort)
            EXISTING_DB_ACTION="$VH_EXISTING_DB_ACTION"
            EXISTING_DB_ACTION_REASON="VH_EXISTING_DB_ACTION=${VH_EXISTING_DB_ACTION}"
            return 0
            ;;
        "")
            ;;
        *)
            EXISTING_DB_ACTION="abort"
            EXISTING_DB_ACTION_REASON="invalid VH_EXISTING_DB_ACTION='${VH_EXISTING_DB_ACTION}' (expected adopt|overwrite|abort)"
            return 0
            ;;
    esac
    if is_noninteractive_context; then
        EXISTING_DB_ACTION="abort"
        EXISTING_DB_ACTION_REASON="noninteractive install; VH_EXISTING_DB_ACTION not set"
        return 0
    fi
    prompt_existing_db_action
}

handle_orphan_local_db() {
    # Orphan: role and/or DB exist, but there is neither a sealed credential nor a
    # pending seed on this host, so the daemon could never authenticate.
    detect_local_db_data_state

    if [ "$DB_DATA_STATE" = "empty" ] && [ -z "${VH_EXISTING_DB_ACTION:-}" ]; then
        detail "Existing Vaulthalla PostgreSQL role/database contain no Vaulthalla data (interrupted install); adopting it."
        if converge_local_db "$(generate_db_password)" 0; then
            DB_BOOTSTRAP_STATUS="done (adopted empty DB left by an interrupted install; runtime password seeded)"
        fi
        return 0
    fi

    if is_upgrade && [ -z "${VH_EXISTING_DB_ACTION:-}" ]; then
        # Never abort an upgrade over this; report and leave PostgreSQL untouched.
        DB_BOOTSTRAP_STATUS="deferred (existing DB has no sealed credential on this host; see resolution commands above)"
        warn_nonfatal "Existing Vaulthalla database has no sealed credential on this host; vaulthalla.service cannot authenticate."
        print_existing_db_resolution_commands >&2
        print_adopt_key_warning
        return 0
    fi

    resolve_existing_db_action
    case "$EXISTING_DB_ACTION" in
        adopt)
            adopt_existing_local_db
            ;;
        overwrite)
            overwrite_existing_local_db
            ;;
        *)
            abort_for_existing_db "$EXISTING_DB_ACTION_REASON"
            ;;
    esac
}

persist_optout_marker() {
    printf '%s\n' "$2" > "$1" 2>/dev/null || true
    chmod 0644 "$1" >/dev/null 2>&1 || true
}

bootstrap_db_if_safe() {
    if env_flag_enabled "${VH_SKIP_DB_BOOTSTRAP:-}"; then
        persist_optout_marker "$DB_BOOTSTRAP_OPTOUT_MARKER" "VH_SKIP_DB_BOOTSTRAP=1"
        DB_BOOTSTRAP_STATUS="skipped (VH_SKIP_DB_BOOTSTRAP=1; persisted at ${DB_BOOTSTRAP_OPTOUT_MARKER})"
        return 0
    fi
    if [ -f "$DB_BOOTSTRAP_OPTOUT_MARKER" ]; then
        DB_BOOTSTRAP_STATUS="skipped (persisted opt-out ${DB_BOOTSTRAP_OPTOUT_MARKER}; 'sudo vh setup db' opts back in)"
        return 0
    fi
    if ! configured_db_is_local; then
        DB_BOOTSTRAP_STATUS="skipped (config.yaml database.host is remote: $(configured_db_host))"
        return 0
    fi
    if sealed_db_secret_present; then
        DB_BOOTSTRAP_STATUS="reused (sealed DB credential present at ${SEALED_DB_SECRET_DIR}; role/database untouched)"
        return 0
    fi

    if ! has_command psql; then
        DB_BOOTSTRAP_STATUS="skipped (psql not installed; install PostgreSQL or configure remote DB)"
        return 0
    fi
    if ! id postgres >/dev/null 2>&1; then
        DB_BOOTSTRAP_STATUS="skipped (local postgres user missing; likely remote/lean install)"
        return 0
    fi
    if ! run_as_postgres true >/dev/null 2>&1; then
        DB_BOOTSTRAP_STATUS="skipped (cannot execute as postgres user)"
        return 0
    fi
    if ! postgresql_server_ready; then
        DB_BOOTSTRAP_STATUS="skipped (local PostgreSQL server not ready)"
        return 0
    fi

    if ! query_local_db_state; then
        DB_BOOTSTRAP_STATUS="skipped (failed to query PostgreSQL role/database state)"
        return 0
    fi

    if pending_db_seed_present; then
        resume_local_db_bootstrap_from_seed
        return 0
    fi

    if [ "$ROLE_EXISTS" = "1" ] || [ "$DB_EXISTS" = "1" ]; then
        handle_orphan_local_db
        return 0
    fi

    perform_fresh_local_db_bootstrap
}

setup_web_runtime_cache() {
    WEB_ROOT="/usr/share/vaulthalla-web"
    CACHE_DIR="/var/cache/vaulthalla-web"
    CACHE_LINK="${WEB_ROOT}/.next/cache"
    CACHE_LINK_TARGET=""

    if [ ! -d "${WEB_ROOT}/.next" ]; then
        detail "Web cache: skipped (${WEB_ROOT}/.next not present)."
        return 0
    fi

    if ! install -d -m 0750 -o "$DB_USER" -g "$DB_USER" "$CACHE_DIR"; then
        warn_nonfatal "Web cache: could not prepare ${CACHE_DIR}; leaving cache setup unchanged."
        return 0
    fi

    if [ -L "$CACHE_LINK" ]; then
        CACHE_LINK_TARGET="$(readlink "$CACHE_LINK" 2>/dev/null || true)"
        if [ "$CACHE_LINK_TARGET" != "$CACHE_DIR" ]; then
            warn_nonfatal "Web cache link exists with unexpected target; leaving unchanged: ${CACHE_LINK} -> ${CACHE_LINK_TARGET}"
            return 0
        fi
    elif [ -e "$CACHE_LINK" ]; then
        warn_nonfatal "Web cache path exists and is not a symlink; leaving unchanged: ${CACHE_LINK}"
        return 0
    else
        if ! ln -s "$CACHE_DIR" "$CACHE_LINK"; then
            warn_nonfatal "Web cache: could not create ${CACHE_LINK}; leaving cache setup unchanged."
            return 0
        fi
    fi

    if [ -L "$CACHE_LINK" ]; then
        chown -h "$DB_USER:$DB_USER" "$CACHE_LINK" 2>/dev/null || true
    fi

    detail "Web cache: ${CACHE_LINK} -> ${CACHE_DIR}"
}

nginx_installed() {
    has_command nginx && [ -d /etc/nginx ]
}

nginx_active() {
    systemd_running && run_systemctl_quiet --quiet is-active nginx.service
}

nginx_config_valid() {
    run_bounded "$NGINX_TIMEOUT_SECONDS" nginx -t >/dev/null 2>&1
}

has_non_nginx_listener_on_web_ports() {
    if ! has_command ss; then
        return 1
    fi
    WEB_LISTENERS="$(ss -H -ltnp '( sport = :80 or sport = :443 )' 2>/dev/null || true)"
    if [ -z "$WEB_LISTENERS" ]; then
        return 1
    fi
    echo "$WEB_LISTENERS" | grep -v "nginx" | grep -q .
}

has_custom_nginx_sites_enabled() {
    if [ ! -d /etc/nginx/sites-enabled ]; then
        return 1
    fi
    for entry in /etc/nginx/sites-enabled/*; do
        [ -e "$entry" ] || continue
        base="$(basename "$entry")"
        case "$base" in
            default|vaulthalla)
                ;;
            *)
                return 0
                ;;
        esac
    done
    return 1
}

nginx_site_link_is_ours() {
    if [ ! -L "$NGINX_SITE_ENABLED" ]; then
        return 1
    fi
    case "$(readlink "$NGINX_SITE_ENABLED" 2>/dev/null || true)" in
        "$NGINX_SITE_AVAIL"|../sites-available/vaulthalla)
            return 0
            ;;
    esac
    return 1
}

nginx_default_site_is_stock_symlink() {
    # True only for the distro default: sites-enabled/default is a symlink to
    # sites-available/default and that file still matches its dpkg conffile checksum.
    if [ ! -L "$NGINX_DEFAULT_SITE_ENABLED" ] || [ ! -f "$NGINX_DEFAULT_SITE_AVAIL" ]; then
        return 1
    fi
    case "$(readlink "$NGINX_DEFAULT_SITE_ENABLED" 2>/dev/null || true)" in
        "$NGINX_DEFAULT_SITE_AVAIL"|../sites-available/default)
            ;;
        *)
            return 1
            ;;
    esac
    if ! has_command dpkg-query || ! has_command md5sum; then
        return 1
    fi
    default_owner="$(dpkg-query -S "$NGINX_DEFAULT_SITE_AVAIL" 2>/dev/null | head -n 1 | cut -d: -f1)"
    if [ -z "$default_owner" ]; then
        return 1
    fi
    expected_md5="$(dpkg-query -W -f='${Conffiles}\n' "$default_owner" 2>/dev/null \
        | awk -v p="$NGINX_DEFAULT_SITE_AVAIL" '$1 == p && $3 != "obsolete" { print $2; exit }')"
    actual_md5="$(md5sum "$NGINX_DEFAULT_SITE_AVAIL" 2>/dev/null | awk '{ print $1 }')"
    [ -n "$expected_md5" ] && [ "$expected_md5" = "$actual_md5" ]
}

disable_stock_nginx_default_site() {
    # The stock default site holds `listen 80 default_server`, so the package site
    # (server_name _) would never answer. Disable only the unmodified distro symlink and
    # record it so prerm/purge/`vh teardown nginx` can restore it.
    DISABLED_DEFAULT_SITE="false"
    if ! nginx_default_site_is_stock_symlink; then
        return 0
    fi
    default_target="$(readlink "$NGINX_DEFAULT_SITE_ENABLED" 2>/dev/null || true)"
    if ! rm -f "$NGINX_DEFAULT_SITE_ENABLED"; then
        return 0
    fi
    printf '%s\n' "target=${default_target}" > "$NGINX_DEFAULT_DISABLED_MARKER" 2>/dev/null || true
    DISABLED_DEFAULT_SITE="true"
    say "nginx: disabled the unmodified distro default site (${NGINX_DEFAULT_SITE_ENABLED}); it is restored on remove/purge or 'vh teardown nginx'."
}

restore_nginx_default_site_if_disabled() {
    if [ ! -f "$NGINX_DEFAULT_DISABLED_MARKER" ]; then
        return 0
    fi
    default_target="$(sed -n 's/^target=//p' "$NGINX_DEFAULT_DISABLED_MARKER" 2>/dev/null | head -n 1)"
    if [ -z "$default_target" ]; then
        default_target="$NGINX_DEFAULT_SITE_AVAIL"
    fi
    if [ ! -e "$NGINX_DEFAULT_SITE_ENABLED" ] && [ ! -L "$NGINX_DEFAULT_SITE_ENABLED" ] && [ -f "$NGINX_DEFAULT_SITE_AVAIL" ]; then
        ln -s "$default_target" "$NGINX_DEFAULT_SITE_ENABLED" 2>/dev/null || true
    fi
    rm -f "$NGINX_DEFAULT_DISABLED_MARKER"
}

# sha256 of every plain-HTTP packaged site this package shipped before #324. An installed site identical to one of
# them is ours and unmodified: it is replaced with the HTTPS template. Anything else (edited, or generated by
# `vh setup nginx`) is left alone with a hint.
LEGACY_HTTP_TEMPLATE_SHA256S="3f446bc22582688fd7960d6cea823caacae03a6737ad88ad94a9b79080b9722f 5115b504b8dc88a8d349d6d117f13b0a818e414bda8d928d136720be78a7ca63 f0864a1c69d0bb3a547b4dffa29e34d6bc1759596b1fe940a0e3632ce5f87c12 fcaa173a4d87cdd8a25f8affa311d54c16817e73dea680a62c30a4af53abd63e"
LIFECYCLE_BIN="/usr/lib/vaulthalla/lifecycle"

ensure_local_tls_certificate() {
    if [ ! -x "$LIFECYCLE_BIN" ] || ! has_command python3; then
        return 1
    fi
    run_bounded 60 "$LIFECYCLE_BIN" setup local-tls --quiet >/dev/null 2>&1
}

upgrade_legacy_http_site() {
    [ -f "$NGINX_SITE_AVAIL" ] || return 0
    has_command sha256sum || return 0
    current="$(sha256sum "$NGINX_SITE_AVAIL" 2>/dev/null | cut -d' ' -f1)"
    for legacy in $LEGACY_HTTP_TEMPLATE_SHA256S; do
        if [ "$current" = "$legacy" ]; then
            if install -m 0644 "$NGINX_TEMPLATE" "$NGINX_SITE_AVAIL"; then
                say "nginx: the packaged site now serves HTTPS with this host's local certificate (http:// redirects)."
            fi
            return 0
        fi
    done
    if ! grep -q "ssl_certificate" "$NGINX_SITE_AVAIL" 2>/dev/null; then
        warn_nonfatal "nginx: ${NGINX_SITE_AVAIL} serves plain HTTP. Run 'sudo vh setup nginx' for HTTPS (or '--certbot --domain <fqdn>' for a public certificate)."
    fi
}

probe_local_http_root() {
    # Prints "<status> <welcome-page:0|1>" for GET http://127.0.0.1/ (Host: localhost). The Vaulthalla site redirects
    # HTTP to HTTPS (#324); the redirect is followed to https://127.0.0.1/ without certificate verification (this is
    # the host's own self-signed certificate, probed over loopback).
    if ! has_command python3; then
        printf '%s\n' "000 0"
        return 0
    fi
    run_bounded 10 python3 - <<'EOF' 2>/dev/null || printf '%s\n' "000 0"
import http.client
import ssl
try:
    conn = http.client.HTTPConnection("127.0.0.1", 80, timeout=5)
    conn.request("GET", "/", headers={"Host": "localhost"})
    resp = conn.getresponse()
    body = resp.read(65536)
    if resp.status in (301, 302, 307, 308) and (resp.getheader("Location") or "").startswith("https://"):
        tls = http.client.HTTPSConnection("127.0.0.1", 443, timeout=5, context=ssl._create_unverified_context())
        tls.request("GET", "/", headers={"Host": "localhost"})
        resp = tls.getresponse()
        body = resp.read(65536)
    print(resp.status, 1 if b"Welcome to nginx" in body else 0)
except Exception:
    print("000 0")
EOF
}

verify_nginx_serves_vaulthalla() {
    # Sets NGINX_VERIFY_STATUS; never fails configure.
    NGINX_VERIFY_STATUS="not verified"
    waited=0
    while :; do
        probe="$(probe_local_http_root)"
        http_status="${probe%% *}"
        welcome_page="${probe##* }"
        # nginx reloads asynchronously: old workers can keep serving the previous site set for a moment,
        # so the welcome page is only conclusive once the probe window has passed (seen on vh-storage).
        if [ "$welcome_page" = "1" ]; then
            if [ "$waited" -ge "$HTTP_PROBE_WINDOW_SECONDS" ]; then
                NGINX_VERIFY_STATUS="NOT serving Vaulthalla: another nginx site (distro welcome page) answers http://127.0.0.1/"
                return 1
            fi
            http_status="welcome"
        fi
        case "$http_status" in
            welcome|502|503|504)
                ;;
            000|"")
                NGINX_VERIFY_STATUS="not verified (no HTTP response from 127.0.0.1:80)"
                return 1
                ;;
            *)
                NGINX_VERIFY_STATUS="verified (HTTP ${http_status} from the Vaulthalla web console via nginx)"
                return 0
                ;;
        esac
        if [ "$waited" -ge "$HTTP_PROBE_WINDOW_SECONDS" ]; then
            NGINX_VERIFY_STATUS="site active, but the web upstream is not answering yet (HTTP ${http_status}; check ${WEB_SYSTEMD_UNIT})"
            return 1
        fi
        sleep 2
        waited=$((waited + 2))
    done
}

configure_nginx_if_safe() {
    if env_flag_enabled "${VH_SKIP_NGINX_CONFIG:-}"; then
        persist_optout_marker "$NGINX_OPTOUT_MARKER" "VH_SKIP_NGINX_CONFIG=1"
        NGINX_CONFIG_STATUS="skipped (VH_SKIP_NGINX_CONFIG=1; persisted at ${NGINX_OPTOUT_MARKER})"
        return 0
    fi
    if [ -f "$NGINX_OPTOUT_MARKER" ]; then
        NGINX_CONFIG_STATUS="skipped (persisted opt-out ${NGINX_OPTOUT_MARKER}; 'sudo vh setup nginx' opts back in)"
        return 0
    fi
    if is_upgrade; then
        # Upgrades never create or re-enable the site: an operator who ran
        # `vh teardown nginx` or removed the link keeps that choice.
        if [ ! -f "$NGINX_MANAGED_MARKER" ] || ! nginx_site_link_is_ours; then
            NGINX_CONFIG_STATUS="unchanged (upgrade leaves nginx integration as the operator left it)"
            return 0
        fi
    fi

    if ! nginx_installed; then
        NGINX_CONFIG_STATUS="skipped (nginx not installed; install nginx for reverse-proxy integration)"
        return 0
    fi
    if ! nginx_active; then
        NGINX_CONFIG_STATUS="skipped (nginx installed but inactive)"
        return 0
    fi
    if has_non_nginx_listener_on_web_ports; then
        NGINX_CONFIG_STATUS="skipped (non-nginx listeners active on 80/443)"
        return 0
    fi
    if has_custom_nginx_sites_enabled; then
        NGINX_CONFIG_STATUS="skipped (custom nginx site layout detected)"
        return 0
    fi
    if [ ! -f "$NGINX_TEMPLATE" ]; then
        NGINX_CONFIG_STATUS="skipped (missing packaged nginx template)"
        return 0
    fi

    # HTTPS by default (#324): the packaged site serves the host-local certificate, created before nginx sees it.
    if ! ensure_local_tls_certificate; then
        NGINX_CONFIG_STATUS="skipped (could not create the local HTTPS certificate; run 'sudo vh setup local-tls')"
        warn_nonfatal "nginx: could not create the local HTTPS certificate; site left unchanged. Run 'sudo vh setup local-tls', then 'sudo vh setup nginx'."
        return 0
    fi
    upgrade_legacy_http_site

    if ! install -d -m 0755 /etc/nginx/sites-available /etc/nginx/sites-enabled; then
        NGINX_CONFIG_STATUS="skipped (failed preparing nginx site directories)"
        warn_nonfatal "nginx config: could not prepare site directories; skipping automatic nginx integration."
        return 0
    fi

    if [ ! -f "$NGINX_SITE_AVAIL" ]; then
        if ! install -m 0644 "$NGINX_TEMPLATE" "$NGINX_SITE_AVAIL"; then
            NGINX_CONFIG_STATUS="skipped (failed installing nginx site template)"
            warn_nonfatal "nginx config: could not install ${NGINX_SITE_AVAIL}; skipping automatic nginx integration."
            return 0
        fi
        printf '%s\n' "managed-by=${PKG}" > "$NGINX_MANAGED_MARKER" 2>/dev/null || true
        chmod 0644 "$NGINX_MANAGED_MARKER" >/dev/null 2>&1 || true
    fi

    CREATED_SITE_LINK="false"
    if [ -L "$NGINX_SITE_ENABLED" ]; then
        if ! nginx_site_link_is_ours; then
            NGINX_CONFIG_STATUS="skipped (${NGINX_SITE_ENABLED} symlink target is managed externally)"
            return 0
        fi
    elif [ -e "$NGINX_SITE_ENABLED" ]; then
        NGINX_CONFIG_STATUS="skipped (${NGINX_SITE_ENABLED} exists and is not a symlink)"
        return 0
    else
        if ! ln -s "$NGINX_SITE_AVAIL" "$NGINX_SITE_ENABLED"; then
            NGINX_CONFIG_STATUS="skipped (failed enabling nginx site)"
            warn_nonfatal "nginx config: could not create ${NGINX_SITE_ENABLED}; skipping automatic nginx integration."
            return 0
        fi
        CREATED_SITE_LINK="true"
    fi

    disable_stock_nginx_default_site

    if nginx_config_valid; then
        safe_systemctl reload nginx.service
        if verify_nginx_serves_vaulthalla; then
            NGINX_CONFIG_STATUS="done (package-managed nginx site enabled; ${NGINX_VERIFY_STATUS})"
        else
            NGINX_CONFIG_STATUS="enabled, but ${NGINX_VERIFY_STATUS}"
            warn_nonfatal "nginx: ${NGINX_VERIFY_STATUS}. Run 'sudo vh setup nginx --domain <fqdn>' or review /etc/nginx/sites-enabled."
        fi
        return 0
    fi

    if [ "$CREATED_SITE_LINK" = "true" ]; then
        rm -f "$NGINX_SITE_ENABLED" || true
    fi
    if [ "$DISABLED_DEFAULT_SITE" = "true" ]; then
        restore_nginx_default_site_if_disabled
    fi
    NGINX_CONFIG_STATUS="skipped (nginx config test failed; reverted site enablement)"
    warn_nonfatal "nginx: 'nginx -t' failed; Vaulthalla site left disabled. Check: sudo nginx -t"
    return 0
}

reconcile_swtpm_unit_enablement() {
    # Runs after the debhelper snippets: deb-systemd-helper enables every shipped unit on first
    # install, including vaulthalla-swtpm on hosts that use a hardware TPM.
    if has_hardware_tpm; then
        safe_systemctl_unit_files disable "$SWTPM_SYSTEMD_UNIT"
    fi
}

legacy_cli_units_present() {
    for unit in $LEGACY_CLI_UNITS; do
        for dir in $LEGACY_CLI_UNIT_DIRS; do
            if [ -e "${dir}/${unit}" ]; then
                return 0
            fi
        done
        if [ -e "${DEB_SYSTEMD_HELPER_STATE_DIR}/deb-systemd-helper-enabled/${unit}.dsh-also" ] \
            || [ -e "${DEB_SYSTEMD_HELPER_STATE_DIR}/deb-systemd-helper-masked/${unit}" ]; then
            return 0
        fi
        if systemd_running; then
            case "$(unit_active_state "$unit")" in
                inactive|unknown)
                    ;;
                *)
                    return 0
                    ;;
            esac
        fi
    done
    for link in $LEGACY_CLI_WANTS_LINKS; do
        if [ -L "$link" ]; then
            return 0
        fi
    done
    return 1
}

stop_legacy_cli_unit_bounded() {
    unit="$1"
    case "$(unit_active_state "$unit")" in
        inactive|unknown)
            return 0
            ;;
        failed)
            run_systemctl_quiet reset-failed "$unit" || true
            return 0
            ;;
    esac
    # deb-systemd-invoke honours policy-rc.d (chroots, image builds) and then runs systemctl stop.
    if has_command deb-systemd-invoke; then
        if run_bounded "$SERVICE_TRANSITION_TIMEOUT_SECONDS" deb-systemd-invoke stop "$unit" >/dev/null 2>&1; then
            rc=0
        else
            rc=$?
        fi
    elif run_bounded "$SERVICE_TRANSITION_TIMEOUT_SECONDS" systemctl --system stop "$unit" >/dev/null 2>&1; then
        rc=0
    else
        rc=$?
    fi
    if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
        warn_nonfatal "${unit}: stop did not finish within ${SERVICE_TRANSITION_TIMEOUT_SECONDS}s; sending SIGKILL to the unit cgroup."
        run_systemctl_quiet kill -s KILL "$unit" || true
        wait_for_unit_to_settle "$unit" "$SERVICE_KILL_SETTLE_SECONDS" || true
    elif [ "$rc" -ne 0 ]; then
        warn_nonfatal "${unit}: stop failed (exit ${rc}); continuing."
    fi
    run_systemctl_quiet reset-failed "$unit" || true
    return 0
}

retire_legacy_cli_units() {
    # Upgrades from releases that shipped vaulthalla-cli.{socket,service}: stop them, drop their
    # enablement, and reload systemd. dpkg has already removed the unit files by now, but a
    # running socket unit stays loaded (and listening) until it is stopped. Idempotent, never fatal.
    # Stopping the socket (RemoveOnStop=yes) deletes cli.sock; the vaulthalla.service restart in
    # configure_systemd_units makes the daemon bind it again.
    if ! legacy_cli_units_present; then
        return 0
    fi
    detail "Retiring legacy ${LEGACY_CLI_UNITS} (vaulthalla.service owns ${CLI_SOCKET_PATH})."
    LEGACY_CLI_UNITS_RETIRED="1"

    if systemd_running; then
        for legacy_unit in $LEGACY_CLI_UNITS; do
            stop_legacy_cli_unit_bounded "$legacy_unit"
        done
    fi

    if has_command deb-systemd-helper; then
        # purge drops the enablement links it recorded plus its state; unmask undoes a remove-time mask.
        # shellcheck disable=SC2086
        run_bounded 30 deb-systemd-helper purge $LEGACY_CLI_UNITS >/dev/null 2>&1 || true
        # shellcheck disable=SC2086
        run_bounded 30 deb-systemd-helper unmask $LEGACY_CLI_UNITS >/dev/null 2>&1 || true
    fi
    for link in $LEGACY_CLI_WANTS_LINKS; do
        if [ -L "$link" ]; then
            rm -f "$link"
        fi
    done
    safe_systemctl daemon-reload
}

verify_cli_socket_owned_by_daemon() {
    # Report whether the daemon (re)created its CLI socket. Only /run is inspected, never the FUSE mount.
    if ! systemd_running; then
        return 0
    fi
    core_state="$(unit_active_state "$CORE_SYSTEMD_UNIT")"
    if [ "$core_state" != "active" ]; then
        CLI_SOCKET_STATUS="not checked (${CORE_SYSTEMD_UNIT} is not active)"
        if [ "$CORE_EXPECTED_UP" = "1" ]; then
            SERVICE_STATUS="${SERVICE_STATUS}; ${CORE_SYSTEMD_UNIT} is '${core_state}'"
            mark_degraded "${CORE_SYSTEMD_UNIT} is '${core_state}' after configure (check: journalctl -u ${CORE_SYSTEMD_UNIT})"
        fi
        return 0
    fi
    waited=0
    while [ "$waited" -lt "$CLI_SOCKET_WAIT_SECONDS" ]; do
        if [ -S "$CLI_SOCKET_PATH" ]; then
            CLI_SOCKET_STATUS="${CLI_SOCKET_PATH} bound by ${CORE_SYSTEMD_UNIT}"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done
    CLI_SOCKET_STATUS="${CLI_SOCKET_PATH} missing ${CLI_SOCKET_WAIT_SECONDS}s after ${CORE_SYSTEMD_UNIT} started; 'vh' cannot connect (check: journalctl -u ${CORE_SYSTEMD_UNIT})"
    warn_nonfatal "$CLI_SOCKET_STATUS"
    mark_degraded "CLI socket missing"
}

core_start_blocker() {
    # Prints why vaulthalla.service must not be started (empty when it can start).
    if [ "$TPM_BACKEND_READY" != "1" ]; then
        printf '%s' "no TPM backend"
        return 0
    fi
    if ! sealed_db_secret_present && ! pending_db_seed_present; then
        printf '%s' "no database credential yet (run 'sudo vh setup db' or 'sudo vh setup remote-db ...')"
        return 0
    fi
}

configure_systemd_units() {
    safe_systemctl daemon-reload

    if is_upgrade; then
        detail "Systemd: upgrade detected; restarting active Vaulthalla units only (bounded to ${SERVICE_TRANSITION_TIMEOUT_SECONDS}s each)."
        # Capture 'failed' before the try-restarts below (transition_unit_bounded resets failed units).
        failed_before=""
        case "$(unit_active_state "$CORE_SYSTEMD_UNIT")" in
            active|activating|reloading)
                CORE_EXPECTED_UP="1"
                ;;
        esac
        for unit in "$CORE_SYSTEMD_UNIT" "$WEB_SYSTEMD_UNIT"; do
            if [ "$(unit_active_state "$unit")" = "failed" ]; then
                failed_before="${failed_before} ${unit}"
            fi
        done
        transition_unit_bounded try-restart "$SWTPM_SYSTEMD_UNIT"
        # The core restart also re-creates cli.sock after retire_legacy_cli_units stopped the old socket.
        transition_unit_bounded try-restart "$CORE_SYSTEMD_UNIT"
        transition_unit_bounded try-restart "$WEB_SYSTEMD_UNIT"
        SERVICE_STATUS="restarted active units"
        # try-restart leaves a stopped unit alone, which is right for an operator's 'systemctl stop'
        # (inactive). A unit in 'failed' state crashed or hit its start limit instead; the upgrade that
        # ships the fix should bring it back (vh-storage: StartLimit-failed daemon stayed down after a
        # fixing upgrade).
        restarted_failed=""
        for unit in $failed_before; do
            if run_bounded 10 systemctl --system is-enabled --quiet "$unit" >/dev/null 2>&1; then
                if [ "$unit" = "$CORE_SYSTEMD_UNIT" ] && [ -n "$(core_start_blocker)" ]; then
                    continue
                fi
                detail "Systemd: ${unit} was in failed state; starting it."
                transition_unit_bounded start "$unit"
                if [ "$unit" = "$CORE_SYSTEMD_UNIT" ]; then
                    CORE_EXPECTED_UP="1"
                fi
                restarted_failed="${restarted_failed:+${restarted_failed}, }${unit}"
            fi
        done
        if [ -n "$restarted_failed" ]; then
            SERVICE_STATUS="restarted active units; started previously failed ${restarted_failed}"
        fi
        if [ "$TPM_BACKEND_RECOVERED" = "1" ] && [ -z "$(core_start_blocker)" ]; then
            detail "Systemd: TPM backend is now available; starting ${CORE_SYSTEMD_UNIT}."
            transition_unit_bounded start "$CORE_SYSTEMD_UNIT"
            CORE_EXPECTED_UP="1"
            SERVICE_STATUS="restarted active units; started ${CORE_SYSTEMD_UNIT} after TPM backend recovery"
        fi
        return 0
    fi

    if [ "$INSTALL_MODE" = "reinstall" ]; then
        detail "Systemd: reinstall over removed package; restoring enabled/started units."
    fi

    safe_systemctl_unit_files enable "$CORE_SYSTEMD_UNIT"
    safe_systemctl_unit_files enable "$WEB_SYSTEMD_UNIT"

    if ! systemd_running; then
        SERVICE_STATUS="units enabled; not started (systemd is not running)"
        return 0
    fi

    blocker="$(core_start_blocker)"
    if [ -n "$blocker" ]; then
        SERVICE_STATUS="units enabled; ${CORE_SYSTEMD_UNIT} NOT started: ${blocker}"
        warn_nonfatal "${CORE_SYSTEMD_UNIT} not started: ${blocker}."
    else
        transition_unit_bounded start "$CORE_SYSTEMD_UNIT"
        CORE_EXPECTED_UP="1"
        # Report what actually happened: a daemon that exits during startup is "activating"
        # (auto-restart) or "failed" a few seconds later, not "active".
        sleep 3
        core_state="$(unit_active_state "$CORE_SYSTEMD_UNIT")"
        if [ "$core_state" = "active" ]; then
            SERVICE_STATUS="units enabled and started (${CORE_SYSTEMD_UNIT} active)"
        else
            SERVICE_STATUS="units enabled; ${CORE_SYSTEMD_UNIT} is '${core_state}' after start (check: journalctl -u ${CORE_SYSTEMD_UNIT})"
            warn_nonfatal "${CORE_SYSTEMD_UNIT} is '${core_state}' after start; check: journalctl -u ${CORE_SYSTEMD_UNIT}"
        fi
    fi
    transition_unit_bounded start "$WEB_SYSTEMD_UNIT"
}

readopt_operator_testing_dir() {
    # ${CONFIG_DIR}/testing holds operator-managed TEST-ONLY credentials (tools/lab/providers.env.example).
    # The package never creates or rewrites it, but purge deletes the vaulthalla group, leaving the directory
    # on a dangling gid; on reinstall hand it back to the (new) vaulthalla group so the service user can read it.
    testing_dir="${CONFIG_DIR}/testing"
    [ -d "$testing_dir" ] || return 0
    [ ! -L "$testing_dir" ] || return 0
    dir_gid="$(stat -c '%g' "$testing_dir" 2>/dev/null || true)"
    [ -n "$dir_gid" ] || return 0
    if getent group "$dir_gid" >/dev/null 2>&1; then
        return 0
    fi
    if chgrp -hR "$DB_USER" "$testing_dir" >/dev/null 2>&1; then
        detail "Re-adopted ${testing_dir} for group '${DB_USER}' (previous group id ${dir_gid} no longer exists)."
    else
        warn_nonfatal "could not re-adopt ${testing_dir} for group '${DB_USER}'"
    fi
}

summary_lines() {
    printf '%s\n' "Install summary (${INSTALL_MODE}):"
    printf '%s\n' "  Config: ${CONFIG_STATUS}"
    printf '%s\n' "  DB bootstrap: ${DB_BOOTSTRAP_STATUS}"
    printf '%s\n' "  TPM backend: ${TPM_BACKEND_STATUS}"
    printf '%s\n' "  Services: ${SERVICE_STATUS}"
    printf '%s\n' "  CLI socket: ${CLI_SOCKET_STATUS}"
    printf '%s\n' "  nginx config: ${NGINX_CONFIG_STATUS}"
    printf '%s\n' "  Super-admin ownership: deferred to first CLI use ('vh' or 'vaulthalla')."
    # The daemon generates the web 'admin' password once, on a new database (no universal default); never on upgrade.
    if [ -f "$INITIAL_PASSWORD_FILE" ]; then
        printf '%s\n' "  Web console: sign in as 'admin' with the generated password in ${INITIAL_PASSWORD_FILE} (root-readable). Change it with 'vh setup set-super-admin-password', or keep it and delete the file."
    elif [ "$INSTALL_MODE" = "fresh" ]; then
        printf '%s\n' "  Web console: the generated password for 'admin' is written to ${INITIAL_PASSWORD_FILE} when the service first starts with a new database."
    fi
}

installed_package_version() {
    run_bounded 10 dpkg-query -W -f='${Version}' "$PKG" 2>/dev/null || true
}

upgrade_status_line() {
    # One line for a clean upgrade: what changed and that the services came back.
    new_version="$(installed_package_version)"
    if [ -z "$new_version" ] || [ "$new_version" = "$LAST_CONFIGURED_VERSION" ]; then
        outcome="Reconfigured ${LAST_CONFIGURED_VERSION}"
    else
        outcome="Upgraded ${LAST_CONFIGURED_VERSION} -> ${new_version}"
    fi
    if ! systemd_running; then
        services="services not restarted (systemd is not running)"
    elif [ "$CORE_EXPECTED_UP" = "1" ]; then
        services="services restarted, daemon healthy"
    else
        services="${CORE_SYSTEMD_UNIT} was not running and was left stopped"
    fi
    case "$SERVICE_STATUS" in
        *"started previously failed"*)
            services="${services} (recovered previously failed units)"
            ;;
        *"after TPM backend recovery"*)
            services="${services} (started after TPM backend recovery)"
            ;;
    esac
    printf '%s' "${outcome}: ${services}. Log: ${PACKAGE_LOG}"
}

report_configure_outcome() {
    if [ "$LEGACY_CLI_UNITS_RETIRED" = "1" ]; then
        CLI_SOCKET_STATUS="${CLI_SOCKET_STATUS}; legacy vaulthalla-cli.socket/.service stopped and purged"
    fi
    case "$CONFIG_STATUS" in
        missing*|failed*) mark_degraded "config: ${CONFIG_STATUS}" ;;
    esac
    case "$DB_BOOTSTRAP_STATUS" in
        failed*|deferred*) mark_degraded "DB bootstrap: ${DB_BOOTSTRAP_STATUS}" ;;
    esac

    if [ "$INSTALL_MODE" = "upgrade" ] && [ -z "$DEGRADED_REASONS" ] && ! package_verbose; then
        summary_lines | log_stdin
        say "$(upgrade_status_line)"
        if [ -f "$INITIAL_PASSWORD_FILE" ]; then
            say "Action: the generated web 'admin' password is still in ${INITIAL_PASSWORD_FILE}; change it with 'sudo vh setup set-super-admin-password' or delete the file."
        fi
        return 0
    fi

    if [ -n "$DEGRADED_REASONS" ]; then
        say_err "ERROR: configure finished with problems: ${DEGRADED_REASONS}"
    fi
    summary_lines | while IFS= read -r summary_line; do
        say "${summary_line}"
    done
    if [ "$PACKAGE_LOG_SINK" != "/dev/null" ]; then
        say "Full log: ${PACKAGE_LOG}"
    fi
}

case "$1" in
  configure)
    open_package_log

    if ! id "$DB_USER" >/dev/null 2>&1; then
        adduser --quiet --system --group --home /nonexistent --no-create-home --shell /usr/sbin/nologin "$DB_USER"
    fi

    systemd-tmpfiles --create /usr/lib/tmpfiles.d/vaulthalla.conf >/dev/null 2>&1 || true

    ensure_tss_group_and_user_added
    readopt_operator_testing_dir
    refresh_tpm_udev_rules

    create_dir "$STATE_DIR"   0700 "$DB_USER" "$DB_USER"
    create_dir "$LOG_DIR"     0750 "$DB_USER" "$DB_USER"
    create_dir "$RUNTIME_DIR" 0750 "$DB_USER" "$DB_USER"
    install_default_config_if_missing
    ensure_mount_root /mnt/vaulthalla 0755 "$DB_USER" "$DB_USER"
    setup_web_runtime_cache
    ensure_fuse_allow_other
    align_config_file_permissions "$CONFIG_FILE"
    align_config_file_permissions "$CONFIG_TEMPLATE_FILE"
    require_runtime_assets
    # Early, so nothing later in configure (e.g. an orphan-DB abort) can leave the old socket listening.
    retire_legacy_cli_units
    configure_tpm_backend_if_safe

    # Remove any stale super-admin seed from older package revisions.
    rm -f "$LEGACY_PENDING_SUPERADMIN_UID_FILE"

    bootstrap_db_if_safe

    #DEBHELPER#

    # Everything below runs after the debhelper snippets (unit enablement, tmpfiles).
    reconcile_swtpm_unit_enablement

    configure_systemd_units

    verify_cli_socket_owned_by_daemon

    # Renew the local HTTPS certificate on every install/upgrade when one exists (expiring, or the host's
    # names/addresses changed); the lifecycle tool reloads nginx when the site uses it (#324).
    if [ -f /etc/vaulthalla/tls/local.crt ]; then
        ensure_local_tls_certificate || warn_nonfatal "nginx: could not renew the local HTTPS certificate; run 'sudo vh setup local-tls'."
    fi
    configure_nginx_if_safe

    rm -f "$REINSTALL_MARKER"

    report_configure_outcome
    ;;

  abort-upgrade|abort-remove|abort-deconfigure)
    #DEBHELPER#
    ;;

  *)
    echo "postinst called with unknown argument \`$1'" >&2
    exit 1
    ;;
esac

exit 0
