<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Vaulthalla core daemon as a macOS system service (the counterpart of deploy/systemd/vaulthalla.service.in).
     A LaunchDaemon in the system domain: it starts at boot without anyone logged in and keeps running across logouts.
     It runs as the hidden _vaulthalla account; its state tree is private to that account. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>sh.vaulthalla.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>@BINDIR@/vaulthalla-server</string>
    </array>
    <key>UserName</key>
    <string>_vaulthalla</string>
    <key>GroupName</key>
    <string>_vaulthalla</string>
    <!-- Owner-only by default: sealed secrets, vault bytes and upload staging are created 0600/0700. -->
    <key>Umask</key>
    <integer>63</integer>
    <key>WorkingDirectory</key>
    <string>@STATE_DIR@</string>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart=on-failure: restarted when it exits unsuccessfully, not after a clean stop. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- RestartSec=10. launchd has no StartLimitBurst: the daemon tolerates a database that isn't up yet. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <!-- TimeoutStopSec=30s: SIGTERM, then SIGKILL. The daemon's own shutdown deadline is 10 s. -->
    <key>ExitTimeOut</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Standard</string>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65535</integer>
        <key>Core</key>
        <integer>0</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65535</integer>
        <key>Core</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/server.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/server.log</string>
</dict>
</plist>
